<!-- hidden：页面里有底部弹层/大浮层时把它藏起来。
     tabBar 是页面级原生层，页面内的 fixed + z-index 盖不住它，
     弹层要铺满底部就只能先让位（见 pages/menu 的辣度选择弹层）。 -->
<view class="tabbar" wx:if="{{!hidden}}">
  <view
    class="tab {{selected === item.key ? 'tab-on' : ''}}"
    wx:for="{{tabs}}"
    wx:key="key"
    data-path="{{item.path}}"
    data-key="{{item.key}}"
    bindtap="onTap" hover-class="tap-hover" aria-role="button" aria-label="{{item.text}}">
    <text class="tab-emoji">{{item.emoji}}</text>
    <text class="tab-text">{{item.text}}</text>
    <!-- 角标：掌勺人「待做」= 待开做单数，干饭人「我的订单」= 正在做的单数 -->
    <text class="tab-badge" wx:if="{{item.badge}}">{{item.badge}}</text>
  </view>
</view>
