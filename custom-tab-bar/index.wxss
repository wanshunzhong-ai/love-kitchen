/* 按压反馈 .tap-hover（hover-class 引用它）—— tabBar 也是自定义组件，
   样式默认隔离，必须自己引一次，否则 tab 按下去没反应。 */
@import "../styles/tap.wxss";

/* 自定义 tabBar：白底圆角浮起，粉色选中态
   实测高度 = 内容 100rpx（14 + 44 + 4 + 32 + 6）+ 底部 10rpx ≈ 110rpx
   页面里要避让它的浮层，按「110rpx + safe-area-inset-bottom」算。 */
.tabbar {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 0;
  /* 安全区双写：先给常量兜底，再让 env() 覆盖（环境不认 env 时不会归零） */
  padding-bottom: 10rpx;
  padding-bottom: calc(10rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(10rpx + env(safe-area-inset-bottom));
  margin-bottom: 0;
  display: flex;
  background: #ffffff;
  border-top: 2rpx solid #F6E3DC;
  border-radius: var(--radius-card) 24rpx 0 0;
  box-shadow: 0 -6rpx 24rpx rgba(255, 122, 158, 0.08);
}

.tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  padding: 14rpx 0 6rpx;
  color: #B9A29B;
  transition: color 0.15s;
  /* 角标要绝对定位到这个 tab 上 */
  position: relative;
}

/* 数字角标：贴在 emoji 右上角。
   字号跟全站下限一致（22rpx），再小在真机上看不清。 */
.tab-badge {
  position: absolute;
  top: 2rpx;
  left: 50%;
  /* 用 margin-left 推开，避免为它引入 flex 布局（安卓部分内核 gap 不支持） */
  margin-left: 10rpx;
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  padding: 0 8rpx;
  box-sizing: border-box;
  text-align: center;
  font-size: 22rpx;
  font-weight: 600;
  color: #ffffff;
  background: #FF5C8A;
  border: 2rpx solid #ffffff;
  border-radius: var(--radius-pill);
  box-shadow: 0 2rpx 8rpx rgba(255, 92, 138, 0.35);
}

/* 固定盒高：不同机型 emoji 字形高低不一，不锁死会把 tabBar 撑得一高一低 */
.tab-emoji {
  font-size: 40rpx;
  line-height: 44rpx;
  height: 44rpx;
}

.tab-text {
  margin-top: 4rpx;
  font-size: 22rpx;
  line-height: 32rpx;
  height: 32rpx;
  font-weight: 600;
  /* 「我的资料」四个字也保证不折行 */
  white-space: nowrap;
}

.tab-on {
  color: var(--brand);
}
