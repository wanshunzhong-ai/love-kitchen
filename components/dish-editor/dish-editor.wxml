<!-- 换菜：整个面板交给 dish-picker（它自带遮罩 / 弹层 / 分类 / 搜索）。
     头部用「← 返回」而不是 ✕ —— 关掉它是回编辑态，不是关掉整个改菜面板。 -->
<dish-picker
  wx:if="{{pickerOpen}}"
  visible="{{true}}"
  title="🔄 换一道菜"
  back-text="返回"
  bind:pick="onPickerPick"
  bind:close="closePicker"
/>

<!-- 改这道菜：辣度 / 备注 -->
<view wx:else class="de-mask" bindtap="onClose">
  <view class="de-sheet" catchtap="noop">
    <view class="de-head">
      <text class="de-title">✏️ 改这道菜</text>
      <text class="de-close" bindtap="onClose" hover-class="tap-hover" aria-role="button" aria-label="关闭">✕</text>
    </view>

    <view class="de-cur">
      <text class="de-cur-emoji">{{item.emoji}}</text>
      <view class="de-cur-info">
        <text class="de-cur-name">{{item.name}}</text>
        <text class="de-cur-sub">{{spice}}{{note ? ' · ' + note : ''}}</text>
      </view>
    </view>

    <view class="de-field">
      <view class="de-label">🌶️ 辣度</view>
      <view class="de-chips">
        <text
          class="de-chip {{spice === sp.key ? 'de-chip-on' : ''}}"
          wx:for="{{spiceLevels}}"
          wx:for-item="sp"
          wx:key="key"
          data-spice="{{sp.key}}"
          bindtap="onTapSpice" hover-class="tap-hover" aria-role="button">{{sp.key}}</text>
      </view>
    </view>

    <view class="de-field">
      <view class="de-label">📝 这道菜的备注<text class="de-hint">（{{noteMax}} 字以内）</text></view>
      <input
        class="de-input"
        value="{{note}}"
        placeholder="比如：少放盐、不放葱"
        placeholder-class="de-ph"
        maxlength="{{noteMax}}"
        confirm-type="done"
        bindinput="onNoteInput"
        bindblur="onNoteBlur"
      />
      <view class="de-chips">
        <text
          class="de-chip de-chip-tag"
          wx:for="{{noteTags}}"
          wx:for-item="tag"
          wx:key="*this"
          data-tag="{{tag}}"
          bindtap="onTapNoteTag" hover-class="tap-hover" aria-role="button">{{tag}}</text>
        <text class="de-chip de-chip-clear" wx:if="{{note}}" bindtap="onClearNote" hover-class="tap-hover" aria-role="button">清空</text>
      </view>
    </view>

    <view class="de-swap" bindtap="openPicker" hover-class="tap-hover" aria-role="button">🔄 换一道菜</view>
    <view class="de-done" bindtap="onClose" hover-class="tap-hover" aria-role="button">好了</view>
  </view>
</view>
