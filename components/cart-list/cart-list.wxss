/* 购物车 / 订单条目行（组件内自包含：小程序自定义组件默认样式隔离，
   页面与全局样式都进不来，所以用到的都要写在这里）。
   用到的 var(--radius-pill) / var(--grad-main) 来自 styles/common.wxss ——
   CSS 变量是继承属性，能穿透组件边界，组件内照样解析得出来。 */

.cart-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #FFF2EC;
}

.cart-item:last-child {
  border-bottom: none;
}

.ci-main {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.ci-emoji {
  font-size: 44rpx;
  width: 72rpx;
  text-align: center;
  flex-shrink: 0;
}

.ci-info {
  flex: 1;
  min-width: 0;
  padding: 0 12rpx;
}

/* 菜名 + 「改这道菜」入口 */
.ci-name-row {
  display: flex;
  align-items: center;
  min-width: 0;
}

.ci-name {
  font-size: 28rpx;
  color: #4A3B38;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.ci-edit {
  flex-shrink: 0;
  margin-left: 10rpx;
  padding: 0 12rpx;
  font-size: 22rpx;
  line-height: 38rpx;
  border-radius: var(--radius-pill);
  background: #FFF3F6;
  border: 2rpx solid #FFE0EA;
}

/* 辣度 */
.ci-spice {
  margin-top: 10rpx;
}

/* 收起态：只显示选定的那一档，点一下展开 */
.ci-spice-cur {
  display: inline-flex;
  align-items: center;
  font-size: 22rpx;
  line-height: 44rpx;
  padding: 0 18rpx;
  border-radius: var(--radius-pill);
  color: #A89690;
  background: #F8F3F1;
  border: 2rpx solid #EFE6E2;
}

.csc-caret {
  margin-left: 8rpx;
  font-size: 22rpx;
  opacity: 0.65;
}

/* 越辣越红：0 不辣走默认灰，1~3 逐级加深 */
.ci-spice-cur.splv-1 {
  color: #E08A4B;
  background: #FFF4E9;
  border-color: #F6DCC0;
}

.ci-spice-cur.splv-2 {
  color: #D9614A;
  background: #FFEFE7;
  border-color: #F7C8B0;
}

.ci-spice-cur.splv-3 {
  color: #D42B2B;
  background: #FFE7E4;
  border-color: #F5B6AE;
}

/* 展开态：四档全显示，选中的高亮 */
.ci-spices {
  display: flex;
}

.ci-chip {
  font-size: 22rpx;
  line-height: 38rpx;
  padding: 0 16rpx;
  margin-right: 10rpx;
  border-radius: var(--radius-pill);
  color: #A89690;
  background: #F8F3F1;
  border: 2rpx solid transparent;
}

.ci-chip-on {
  color: #D42B2B;
  background: #FFE7E4;
  border-color: #F5B6AE;
  font-weight: 600;
}

/* 这一道菜的备注：整行可点，点一下就能写 */
.ci-note {
  margin-top: 8rpx;
  padding: 4rpx 0;
  font-size: 22rpx;
  line-height: 1.4;
  color: #C08A7A;
  word-break: break-all;
}

/* 还没写时的占位引导（浅色，点进去写） */
.ci-note-empty {
  color: #CDBDB7;
}

.ci-actions {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.ci-stepper {
  display: flex;
  align-items: center;
}

.step {
  width: 48rpx;
  height: 48rpx;
  line-height: 44rpx;
  text-align: center;
  border-radius: 50%;
  border: 2rpx solid #EAD9D3;
  color: #8A7772;
  font-size: 30rpx;
}

.step-plus {
  background: var(--grad-main);
  border-color: transparent;
  color: #ffffff;
}

.step-num {
  min-width: 56rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
}

.ci-remove {
  width: 48rpx;
  text-align: center;
  color: #D8C7C1;
  font-size: 26rpx;
  margin-left: 8rpx;
  flex-shrink: 0;
}

/* 列表为空时的说明（编辑订单页把菜全删光时用） */
.cart-hint {
  padding: 32rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: #C9B8B2;
}

/* 追加菜品入口 */
.add-more {
  margin-top: 24rpx;
  text-align: center;
  font-size: 26rpx;
  color: #FF5C8A;
  font-weight: 600;
  background: #FFF3F6;
  border-radius: var(--radius-pill);
  padding: 18rpx 0;
  border: 2rpx dashed #FFD3E0;
}
