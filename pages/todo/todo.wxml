<view class="todo">
  <!-- 顶部：今天概览 -->
  <view class="hero">
    <view class="hero-title">{{todayLabel}} 待做清单</view>
    <view class="hero-sub">{{heroSub}}</view>
  </view>

  <view wx:if="{{loading}}" class="state">
    <text class="state-emoji">🍳</text>
    <text class="state-tip">正在看看厨房…</text>
  </view>

  <view wx:elif="{{loadError}}" class="state">
    <text class="state-emoji">😵</text>
    <text class="state-tip">清单没加载出来，网络可能开小差了</text>
    <button class="btn-retry" bindtap="loadOrders">重试</button>
  </view>

  <view wx:elif="{{isEmpty}}" class="state">
    <text class="state-emoji">☕</text>
    <text class="state-tip">今天没有要做的菜，歇会儿吧</text>
    <text class="state-sub">TA 下单后会出现在这里</text>
  </view>

  <view wx:else>
    <!-- 今天的一日三餐：早餐 / 午餐 / 晚餐 / 夜宵（+ 有单时的「尽快要做」） -->
    <block wx:if="{{todayCount > 0}}">
      <view class="meal" wx:for="{{meals}}" wx:for-item="meal" wx:key="key">
        <view class="meal-head">
          <text class="meal-text">{{meal.emoji}} {{meal.text}}</text>
          <text class="meal-stat">{{meal.orderCount > 0 ? meal.orderCount + ' 单 · ' + meal.dishCount + ' 道菜' : '还没点'}}</text>
        </view>

        <view wx:if="{{meal.orderCount === 0}}" class="meal-empty">这一餐还没有单子</view>

        <view class="order card" wx:for="{{meal.orders}}" wx:for-item="order" wx:key="id">
          <view class="order-head">
            <text class="order-from">来自 {{order.order_by}}</text>
            <text class="order-status s-{{order.status}}">{{statusMap[order.status].emoji}} {{statusMap[order.status].text}}</text>
          </view>

          <view class="order-dine" wx:if="{{meal.showDine}}">📅 {{order.dineText}}</view>

          <view class="order-items">
            <view class="order-item" wx:for="{{order.items}}" wx:for-item="dish" wx:key="rowKey">
              <view class="oi-left">
                <view class="oi-line">
                  <text>{{dish.emoji}} {{dish.name}}</text>
                  <text class="oi-spice spice-{{dish.spiceIdx}}">{{dish.spiceText}}</text>
                </view>
                <view class="oi-note" wx:if="{{dish.note}}">📝 {{dish.note}}</view>
              </view>
              <text class="order-qty">× {{dish.qty}}</text>
            </view>
          </view>

          <view class="order-remark" wx:if="{{order.remark}}">💬 {{order.remark}}</view>

          <!-- 直接在这里推进状态：待开做 → 开做中 → 已上菜 -->
          <view class="order-acts" wx:if="{{isCook}}">
            <view class="act act-go" wx:if="{{order.status === 'pending'}}" data-id="{{order.id}}" catchtap="onStartCooking">🔥 开始做</view>
            <view class="act act-done" wx:else data-id="{{order.id}}" catchtap="onFinishCooking">✅ 做好了</view>
          </view>
        </view>
      </view>
    </block>

    <view wx:else class="meal-empty meal-empty-top">今天还没有单子，等TA点单～</view>

    <!-- 后面几天：只给摘要，具体去订单页看 -->
    <view class="later" wx:if="{{laterGroups.length > 0}}">
      <view class="later-title">📅 后面几天（{{laterDishes}} 道菜等着）</view>
      <view class="later-row" wx:for="{{laterGroups}}" wx:key="key" bindtap="goOrders">
        <text class="later-date">{{item.text}}</text>
        <text class="later-stat">{{item.orderCount}} 单 · {{item.dishCount}} 道菜</text>
        <text class="later-go">›</text>
      </view>
    </view>

    <view class="todo-tip">点「开始做 / 做好了」直接推进；全部订单在中间的「订单」页</view>
  </view>
</view>
