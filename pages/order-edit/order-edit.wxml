<view class="page">
  <!-- 三态统一走 state-block 组件，视觉见 styles/state.wxss -->
  <state-block wx:if="{{loading}}" emoji="📝" tip="正在打开这一单…" />

  <!-- 加载失败：停在页内让用户决定重试还是返回（不再 toast 完就踢回上一页） -->
  <state-block
    wx:elif="{{loadError}}"
    emoji="😵"
    tip="这一单没打开"
    sub="网络开小差了，检查一下再试"
    retry="重试"
    bind:retry="onRetry"
  />

  <block wx:else>
    <!-- ===== 只读态：掌勺人（这一单不是他点的）+ 已上菜的终态 ===== -->
    <block wx:if="{{readonly}}">
      <view class="card section">
        <view class="final-badge">
          <text class="fb-emoji">{{readonlyEmoji}}</text>
          <view class="fb-text">
            <text class="fb-title">{{readonlyTitle}}</text>
            <text class="fb-sub">{{readonlySub}}</text>
          </view>
        </view>
      </view>

      <view class="card section">
        <view class="section-title">
          🧺 这一单的菜
          <text class="title-count">共 {{totalCount}} 道</text>
        </view>

        <view class="ro-item" wx:for="{{items}}" wx:key="key">
          <view class="ro-info">
            <view class="ro-line">
              <text class="ro-name">{{item.emoji}} {{item.name}}</text>
              <text class="ro-spice">{{item.spice}}</text>
            </view>
            <!-- 这一道菜的单独备注 -->
            <view class="ro-note" wx:if="{{item.note}}">📝 {{item.note}}</view>
          </view>
          <text class="ro-qty">× {{item.qty}}</text>
        </view>

        <view class="ro-meta">
          <text class="ro-meta-line">📅 {{dineText}}</text>
          <text class="ro-meta-line">🙋 {{orderBy || '宝贝'}}</text>
          <text class="ro-meta-line" wx:if="{{remark}}">💬 {{remark}}</text>
        </view>

        <!-- 被驳回的单：理由要摆在详情里，掌勺人自己也能回看当时说了什么 -->
        <view class="ro-reject" wx:if="{{rejected}}">
          <text class="rr-label">🙅 驳回理由</text>
          <text class="rr-text">「{{rejectReason || '没写理由'}}」</text>
        </view>
      </view>

      <!-- 掌勺人的全部权力：推进状态 / 驳回（都写不了一点内容） -->
      <block wx:if="{{showStatusActions && !rejected}}">
        <view class="card section">
          <view class="section-title">🍳 接下来怎么办</view>
          <button
            wx:if="{{status === 'pending'}}"
            class="btn-main cook-act"
            bindtap="onStartCooking"
          >🔥 开始做</button>
          <button
            wx:elif="{{status === 'cooking'}}"
            class="btn-main cook-act"
            bindtap="onFinishCooking"
          >✅ 做好了，上菜</button>
          <view wx:if="{{canReject}}" class="btn-reject" bindtap="onReject">🙅 这一单先不做，说一句理由</view>
          <view class="cook-tip">你做不了的话就驳回，TA 会看到理由</view>
        </view>
      </block>

      <!-- 已驳回的单：掌勺人可以把驳回收回来（手滑了有路可退） -->
      <view wx:if="{{status === 'rejected'}}" class="btn-reject" bindtap="onWithdrawReject">↩️ 收回这次驳回</view>

      <!-- 干饭人：已上菜是终态只删不评之外的事；开做中的单删不得 -->
      <view wx:if="{{!isCook && status !== 'cooking'}}" class="btn-delete" bindtap="onDelete">🗑 删掉这一单</view>
    </block>

    <!-- ===== 干饭人：正常编辑（改内容，改不了状态） ===== -->
    <block wx:else>
      <!-- 被驳回：理由放最上面 —— 先看清为什么，再动手改 -->
      <view class="card section reject-card" wx:if="{{rejected}}">
        <view class="rc-head">
          <text class="rc-emoji">🙅</text>
          <text class="rc-title">掌勺人说先不做这一单</text>
        </view>
        <text class="rc-reason">「{{rejectReason || '没写理由'}}」</text>
        <text class="rc-hint">改一改再交回去就好，也可以删掉它</text>
      </view>

      <!-- 菜品清单 -->
      <view class="card section">
        <view class="section-title">
          🧺 这一单的菜
          <text class="title-count">共 {{totalCount}} 道</text>
        </view>

        <view class="cart-item" wx:for="{{items}}" wx:key="key">
          <view class="ci-main">
            <text class="ci-emoji">{{item.emoji}}</text>
            <view class="ci-info">
              <view class="ci-name-row">
                <text class="ci-name">{{item.name}}</text>
                <!-- 打开「改这道菜」面板：辣度 / 备注 / 换菜 -->
                <text class="ci-edit" data-key="{{item.key}}" catchtap="openEditor">✏️</text>
              </view>
              <!-- 辣度：平时只显示当前选定的那一档，点一下就地展开四档重选 -->
              <view class="ci-spice">
                <view
                  wx:if="{{spiceOpenKey !== item.key}}"
                  class="ci-spice-cur splv-{{item.spiceIdx}}"
                  data-key="{{item.key}}"
                  catchtap="onOpenSpice"
                >
                  <text>{{item.spiceLabel}}</text>
                  <text class="csc-caret">▾</text>
                </view>
                <view wx:else class="ci-spices">
                  <text
                    class="ci-chip {{item.spice === sp ? 'ci-chip-on' : ''}}"
                    wx:for="{{spiceLevels}}"
                    wx:for-item="sp"
                    wx:key="key"
                    data-key="{{item.key}}"
                    data-spice="{{sp.key}}"
                    catchtap="onTapSpice"
                  >{{sp.key}}</text>
                </view>
              </view>
              <!-- 这一道菜的备注：点一下就写，不用打开面板 -->
              <view
                class="ci-note {{item.note ? '' : 'ci-note-empty'}}"
                data-key="{{item.key}}"
                catchtap="onTapNote"
              >{{item.note ? '📝 ' + item.note : '＋ 写一句这道菜的备注'}}</view>
            </view>
          </view>

          <view class="ci-actions">
            <view class="ci-stepper">
              <view class="step" data-key="{{item.key}}" data-delta="-1" catchtap="onQtyChange">−</view>
              <text class="step-num">{{item.qty}}</text>
              <view class="step step-plus" data-key="{{item.key}}" data-delta="1" catchtap="onQtyChange">＋</view>
            </view>
            <text class="ci-remove" data-key="{{item.key}}" catchtap="onRemoveItem">✕</text>
          </view>
        </view>

        <view wx:if="{{items.length === 0}}" class="empty-hint">这一单已经空了，从下面加几道菜吧</view>

        <view class="add-dish" bindtap="openPicker">＋ 从菜单加菜</view>
      </view>

      <!-- 用餐时间 -->
      <view class="card section">
        <view class="section-title">📅 什么时候吃<text class="section-hint">（最多提前一周定）</text></view>

        <scroll-view class="dine-dates" scroll-x enhanced="{{true}}" show-scrollbar="{{false}}">
          <view
            class="dine-chip {{dineDate === d.value ? 'dine-chip-on' : ''}} {{d.disabled ? 'dine-chip-off' : ''}}"
            wx:for="{{dineDates}}"
            wx:for-item="d"
            wx:key="value"
            data-value="{{d.value}}"
            bindtap="onPickDineDate"
          >
            <text class="dc-label">{{d.label}}</text>
            <text class="dc-sub">{{d.sub}}</text>
          </view>
        </scroll-view>

        <view class="dine-slots">
          <view
            class="dine-chip dine-chip-wide {{dineSlot === s.key ? 'dine-chip-on' : ''}} {{s.disabled ? 'dine-chip-off' : ''}}"
            wx:for="{{dineSlots}}"
            wx:for-item="s"
            wx:key="key"
            data-key="{{s.key}}"
            bindtap="onPickDineSlot"
          >{{s.emoji}} {{s.text}}<text class="dc-end">{{s.endText}}</text></view>
        </view>
      </view>

      <!-- 谁点的 -->
      <view class="card section">
        <view class="section-title">🙋 谁点的</view>
        <input
          class="input"
          value="{{orderBy}}"
          placeholder="比如：宝贝"
          placeholder-class="ph"
          maxlength="12"
          bindinput="onNickInput"
        />
      </view>

      <!-- 忌口清单：掌勺人看的是 TA 下单时冻结的那一份，干饭人看自己的实时清单 -->
      <view class="card section">
        <view class="section-title">
          {{isCook ? '🚫 TA 的忌口' : '🚫 我的忌口'}}
          <text class="section-hint">{{isCook ? '（下单时告诉你的）' : '（保存时会一起告诉 TA）'}}</text>
        </view>

        <view class="avoid-wrap" wx:if="{{avoids.length > 0}}">
          <view class="avoid-chip" wx:for="{{avoids}}" wx:key="*this">{{item}}</view>
        </view>
        <view class="avoid-none" wx:else>{{isCook ? 'TA 没说有什么忌口' : '还没记忌口 · 掌勺人不知道你不吃什么'}}</view>

        <view class="avoid-add" wx:if="{{!readonly}}" bindtap="onAddAvoid">
          <text>＋ 记一条</text>
          <text class="avoid-count">{{avoids.length}}/{{avoidMax}}</text>
        </view>
      </view>

      <!-- 备注 -->
      <view class="card section">
        <view class="section-title">💬 想对掌勺人说</view>
        <textarea
          class="textarea"
          value="{{remark}}"
          placeholder="辣度、忌口、想说的话…（可不填）"
          placeholder-class="ph"
          maxlength="100"
          bindinput="onRemarkInput"
        />
      </view>

      <!-- 状态：只给看，不给点（改状态是掌勺人的事，这里连控件都不给） -->
      <view class="card section">
        <view class="section-title">📌 这一单到哪一步了</view>
        <view class="status-ro">
          <text class="sro-chip s-{{status}}">{{statusEmoji}} {{statusText}}</text>
        </view>
        <text class="sro-hint">状态由掌勺人更新，你只能改菜和备注</text>
      </view>

      <button class="btn-main submit" disabled="{{saving}}" bindtap="onSave">{{rejected ? '改好重新提交 ✓' : '保存修改 ✓'}}</button>
      <view class="btn-delete" bindtap="onDelete">🗑 删掉这一单</view>
    </block>
  </block>

  <!-- 加菜弹层 -->
  <view wx:if="{{pickerOpen}}" class="mask" bindtap="closePicker">
    <view class="sheet" catchtap="noop">
      <view class="sheet-head">
        <text class="sheet-title">加菜</text>
        <text class="sheet-close" bindtap="closePicker">✕</text>
      </view>

      <scroll-view class="cats" scroll-x enhanced="{{true}}" show-scrollbar="{{false}}">
        <view
          class="cat {{activeCategory === item.key ? 'cat-active' : ''}}"
          wx:for="{{categories}}"
          wx:key="key"
          data-cat="{{item.key}}"
          bindtap="onTapPickerCategory"
        >{{item.emoji}} {{item.key}}</view>
      </scroll-view>

      <scroll-view class="picker-list" scroll-y>
        <view wx:if="{{pickerLoading}}" class="picker-state">正在翻菜单…</view>
        <view wx:elif="{{pickerDishes.length === 0}}" class="picker-state">这个分类下还没有菜</view>
        <view
          class="pick-item"
          wx:for="{{pickerDishes}}"
          wx:key="id"
          data-idx="{{index}}"
          bindtap="onPickDish"
        >
          <text class="pick-emoji">{{item.emoji}}</text>
          <text class="pick-name">{{item.name}}</text>
          <text class="pick-spice">{{item.spice || '不辣'}}</text>
          <text class="pick-add">＋</text>
        </view>
      </scroll-view>
    </view>
  </view>

  <!-- 逐道菜修改：辣度 / 备注 / 换一道菜 -->
  <dish-editor
    wx:if="{{editorOpen}}"
    item="{{editorItem}}"
    bind:change="onEditorChange"
    bind:close="closeEditor"
  />
</view>
