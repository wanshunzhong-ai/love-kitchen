/* 编辑订单页 */
.page {
  padding: 24rpx 24rpx 80rpx;
  /* 底部安全区：不是 tab 页，只需避开全面屏手势条 */
  padding-bottom: 80rpx;
  padding-bottom: calc(40rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.section {
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.section-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 28rpx;
  font-weight: 600;
  color: #4A3B38;
  margin-bottom: 20rpx;
}

.title-count {
  font-size: 22rpx;
  font-weight: 400;
  color: #B9A29B;
}

/* ===== 终态：已上菜的订单在本页只读 ===== */
.final-badge {
  display: flex;
  align-items: center;
}

.fb-emoji {
  font-size: 52rpx;
  width: 78rpx;
  text-align: center;
  flex-shrink: 0;
}

.fb-text {
  flex: 1;
  min-width: 0;
  padding-left: 8rpx;
  display: flex;
  flex-direction: column;
}

.fb-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #4A3B38;
}

.fb-sub {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #B9A29B;
}

/* 只读菜品行（无辣度条、无加减、无 ✏️） */
.ro-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0;
  border-bottom: 2rpx solid #FFF2EC;
}

.ro-item:last-child {
  border-bottom: none;
}

.ro-info {
  flex: 1;
  min-width: 0;
}

.ro-line {
  display: flex;
  align-items: center;
  min-width: 0;
}

.ro-name {
  font-size: 28rpx;
  color: #4A3B38;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.ro-spice {
  flex-shrink: 0;
  margin-left: 10rpx;
  padding: 0 12rpx;
  font-size: 22rpx;
  line-height: 34rpx;
  border-radius: var(--radius-pill);
  color: #A89690;
  background: #F4EDE9;
}

.ro-note {
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.4;
  color: #C08A7A;
  word-break: break-all;
}

.ro-qty {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: 26rpx;
  color: #B9A29B;
}

.ro-meta {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid #FFF2EC;
  display: flex;
  flex-direction: column;
}

.ro-meta-line {
  font-size: 26rpx;
  line-height: 1.8;
  color: #6B5854;
  word-break: break-all;
}

/* 输入 */
.input {
  background: #FFFBF9;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
}

.textarea {
  background: #FFFBF9;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  width: 100%;
  box-sizing: border-box;
  min-height: 120rpx;
}

.ph {
  color: #D8C7C1;
}

/* 状态：只读一格 —— 改状态是掌勺人的事，这里只有一个胶囊 + 一句说明 */
.status-ro {
  display: flex;
  align-items: center;
}

.sro-chip {
  padding: 10rpx 28rpx;
  border-radius: var(--radius-pill);
  font-size: 26rpx;
  font-weight: 600;
}

.s-pending {
  background: #FFF3E5;
  color: #D9822B;
}

.s-cooking {
  background: #FFE9EE;
  color: #E85C8A;
}

.s-done {
  background: #E8F9EE;
  color: #1FA65A;
}

.s-rejected {
  background: #EEF1F6;
  color: #6B7B95;
}

.sro-hint {
  display: block;
  margin-top: 14rpx;
  font-size: 22rpx;
  color: #B9A29B;
}

/* ===== 被驳回：理由卡（干饭人的编辑态放最上面） ===== */
.reject-card {
  background: #F5F7FB;
  border: 2rpx solid #E3E8F1;
}

.rc-head {
  display: flex;
  align-items: center;
  padding-bottom: 10rpx;
}

.rc-emoji {
  font-size: 34rpx;
  padding-right: 12rpx;
}

.rc-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #46536B;
}

.rc-reason {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #33405A;
  padding: 8rpx 0;
  word-break: break-all;
}

.rc-hint {
  display: block;
  font-size: 22rpx;
  color: #9AA6B8;
}

/* ===== 只读态里的驳回理由 ===== */
.ro-reject {
  margin-top: 20rpx;
  padding: 18rpx 22rpx;
  background: #F5F7FB;
  border: 2rpx solid #E3E8F1;
  border-radius: 16rpx;
}

.rr-label {
  display: block;
  font-size: 22rpx;
  color: #6B7B95;
  padding-bottom: 8rpx;
}

.rr-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #46536B;
  word-break: break-all;
}

/* ===== 掌勺人底部那排动作 ===== */
.cook-act {
  margin-top: 4rpx;
  line-height: 92rpx;
  font-size: 30rpx;
}

.cook-tip {
  margin-top: 18rpx;
  text-align: center;
  font-size: 22rpx;
  color: #B9A29B;
}

/* 驳回：描边弱化，跟主按钮拉开主次（点了还要写理由，多一道确认） */
.btn-reject {
  margin-top: 20rpx;
  text-align: center;
  line-height: 88rpx;
  font-size: 28rpx;
  color: #6B7B95;
  background: #F5F7FB;
  border: 2rpx solid #E3E8F1;
  border-radius: var(--radius-pill);
}

/* 按钮 */
.submit {
  margin-top: 16rpx;
  line-height: 96rpx;
  font-size: 30rpx;
}

.btn-delete {
  margin-top: 24rpx;
  text-align: center;
  line-height: 88rpx;
  font-size: 28rpx;
  color: #D9534F;
  background: #FFF1F0;
  border-radius: var(--radius-pill);
}
