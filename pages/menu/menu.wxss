/* 点单页（掌勺人进来是「菜单管理」，同一页面） */
.page {
  padding: 24rpx 24rpx 24rpx;
  /* 底部留白让开自定义 tabBar（110rpx + 安全区）+ 余量，全面屏上最后一张卡片不会被压住 */
  padding-bottom: 200rpx;
  padding-bottom: calc(150rpx + env(safe-area-inset-bottom));
}

.hero {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: linear-gradient(135deg, #FFD3E0, #FFE9C7);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.hero-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #B4435E;
}

.hero-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #C97B8E;
}

/* 不用 flex gap：安卓部分内核不支持，改为子项 margin-top */
.hero-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  flex-shrink: 0;
  padding-left: 20rpx;
}

/* 「加菜」与「批量」并排。同样不用 gap，用子项 margin-left */
.hero-btns {
  display: flex;
  align-items: center;
  margin-top: 14rpx;
}

.hero-btns .hero-import {
  margin-left: 12rpx;
}

.hero-role {
  background: rgba(255, 255, 255, 0.9);
  color: #B4435E;
  font-size: 24rpx;
  font-weight: 600;
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
}

.hero-add {
  background: rgba(255, 255, 255, 0.9);
  color: #FF5C8A;
  font-size: 24rpx;
  font-weight: 600;
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  box-shadow: 0 4rpx 12rpx rgba(255, 122, 158, 0.25);
  white-space: nowrap;
}

/* 批量导入：和「加菜」同款但轻一点（描边款，不与主入口抢注意力） */
.hero-import {
  background: rgba(255, 255, 255, 0.62);
  color: #C9557A;
  font-size: 24rpx;
  font-weight: 600;
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.9);
  white-space: nowrap;
}

/* 「我的订单」已移到干饭人底栏第二个 tab，点单页不再需要入口 */

/* 搜索 */
.search {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 999rpx;
  padding: 0 28rpx;
  margin-bottom: 20rpx;
  border: 2rpx solid #F6E3DC;
  transition: border-color 0.2s, box-shadow 0.2s;
}

.search-on {
  border-color: #FFB3C7;
  box-shadow: 0 4rpx 16rpx rgba(255, 122, 158, 0.15);
}

.search-icon {
  font-size: 26rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.search-input {
  flex: 1;
  height: 76rpx;
  font-size: 28rpx;
  color: #4A3B38;
}

.search-ph {
  color: #C4B2AC;
  font-size: 26rpx;
}

.search-clear {
  width: 48rpx;
  text-align: center;
  color: #C4B2AC;
  font-size: 26rpx;
  flex-shrink: 0;
}

/* 搜索结果提示 */
.result-hint {
  font-size: 24rpx;
  color: #B9A29B;
  padding: 0 8rpx 16rpx;
}

.result-num {
  color: #FF5C8A;
  font-weight: 600;
}

/* 分类 */
.cats {
  white-space: nowrap;
  margin-bottom: 24rpx;
}

.cat {
  display: inline-block;
  padding: 12rpx 30rpx;
  margin-right: 16rpx;
  background: #ffffff;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: #8A7772;
  border: 2rpx solid #F6E3DC;
}

.cat-active {
  background: linear-gradient(135deg, #FF7A9E, #FF9F43);
  color: #ffffff;
  border-color: transparent;
  font-weight: 600;
}

/* 菜品列表 */
.dish {
  display: flex;
  align-items: center;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.dish-emoji {
  font-size: 56rpx;
  width: 96rpx;
  text-align: center;
}

.dish-info {
  flex: 1;
  padding: 0 16rpx;
  overflow: hidden;
}

.dish-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #4A3B38;
}

.dish-name-row {
  display: flex;
  align-items: center;
  min-width: 0;
}

/* 辣度标签：0 不辣(灰) → 3 特辣(红)；字号下限 22rpx，再小真机上看不清 */
.dish-spice {
  margin-left: 12rpx;
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  line-height: 34rpx;
  flex-shrink: 0;
}

.spice-0 {
  background: #F4EDE9;
  color: #A89690;
}

.spice-1 {
  background: #FFE9E0;
  color: #E07B4F;
}

.spice-2 {
  background: #FFDCD6;
  color: #E0533F;
}

.spice-3 {
  background: #FFD0CC;
  color: #D42B2B;
}

.dish-desc {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #B9A29B;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 排序条（掌勺人专属）：左边一颗可点的胶囊，右边一句说明 */
.sortbar {
  display: flex;
  align-items: center;
  margin-bottom: 18rpx;
  padding: 0 8rpx;
}

.sort-chip {
  flex-shrink: 0;
  padding: 10rpx 26rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  line-height: 36rpx;
  color: #8A7772;
  background: #ffffff;
  border: 2rpx solid #F6E3DC;
}

.sort-chip-on {
  color: #E0533F;
  background: #FFF0E8;
  border-color: #FFD8C0;
  font-weight: 600;
}

.sort-tip {
  margin-left: 16rpx;
  flex: 1;
  font-size: 22rpx;
  color: #B9A29B;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 常点标记：给掌勺人看「TA 点过几次」 */
.dish-hot {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #E0533F;
}

.dish-add {
  width: 56rpx;
  height: 56rpx;
  line-height: 52rpx;
  text-align: center;
  border-radius: 50%;
  background: linear-gradient(135deg, #FF7A9E, #FF9F43);
  color: #ffffff;
  font-size: 36rpx;
  font-weight: 700;
  box-shadow: 0 4rpx 12rpx rgba(255, 122, 158, 0.35);
}

/* 随机帮选：固定在右下，要叠在 tabBar（110rpx）和购物车栏之上 */
.lucky {
  position: fixed;
  right: 32rpx;
  bottom: 230rpx;
  bottom: calc(230rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  color: #FF5C8A;
  font-size: 26rpx;
  font-weight: 600;
  padding: 20rpx 32rpx;
  border-radius: 999rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 122, 158, 0.25);
  border: 2rpx solid #FFE3EA;
}

/* 购物车栏：原来贴在 bottom 40rpx，被自定义 tabBar（110rpx + 安全区）整个盖住，
   加完菜根本看不到「去下单」——现在贴着 tabBar 上沿放。 */
.cart-bar {
  position: fixed;
  left: 32rpx;
  right: 32rpx;
  bottom: 126rpx;
  bottom: calc(126rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  background: #3F2F2C;
  color: #ffffff;
  border-radius: 999rpx;
  padding: 16rpx 16rpx 16rpx 32rpx;
  box-shadow: 0 10rpx 30rpx rgba(63, 47, 44, 0.35);
}

.cart-badge {
  min-width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  padding: 0 10rpx;
  box-sizing: border-box;
  text-align: center;
  background: #FF5C8A;
  border-radius: 20rpx;
  font-size: 22rpx;
  margin-right: 16rpx;
}

.cart-label {
  flex: 1;
  font-size: 26rpx;
}

.cart-go {
  background: linear-gradient(135deg, #FF7A9E, #FF9F43);
  border-radius: 999rpx;
  padding: 16rpx 40rpx;
  font-size: 28rpx;
  font-weight: 600;
}

/* ---------- 辣度选择弹层 ---------- */

.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(63, 47, 44, 0.45);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}

.sheet {
  width: 100%;
  background: #FFFCFB;
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx 32rpx 48rpx;
  /* 全面屏底部横条要留位，否则「加入购物车」按钮贴在手势区上 */
  padding-bottom: 48rpx;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  animation: sheet-up 0.22s ease-out;
}

@keyframes sheet-up {
  from { transform: translateY(40rpx); opacity: 0.4; }
  to   { transform: translateY(0);     opacity: 1; }
}

.sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.sheet-dish {
  display: flex;
  align-items: center;
  min-width: 0;
}

.sheet-emoji {
  font-size: 48rpx;
  margin-right: 16rpx;
}

.sheet-name {
  font-size: 34rpx;
  font-weight: 700;
  color: #4A3B38;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sheet-close {
  font-size: 32rpx;
  color: #C4B2AC;
  padding: 8rpx 12rpx;
}

.sheet-tip {
  font-size: 26rpx;
  color: #8A7772;
  margin-bottom: 24rpx;
}

.sheet-tip-sub {
  font-size: 24rpx;
  color: #C4B2AC;
}

/* 辣度四宫格 */
.spice-opts {
  display: flex;
  margin-bottom: 40rpx;
}

.spice-opt {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 22rpx 0;
  margin-right: 16rpx;
  border-radius: 20rpx;
  background: #ffffff;
  border: 3rpx solid #F0E4DF;
  box-sizing: border-box;
}

.spice-opt:last-child {
  margin-right: 0;
}

.so-txt {
  font-size: 26rpx;
  font-weight: 600;
  color: #6B5854;
}

.so-chili {
  font-size: 22rpx;
  margin-top: 6rpx;
  line-height: 1.2;
}

/* 选中的档位按辣度描边，视觉上"越辣越红" */
.spice-opt-on.spice-opt-0 { border-color: #B9A29B; background: #F8F3F1; }
.spice-opt-on.spice-opt-1 { border-color: #E07B4F; background: #FFF3EC; }
.spice-opt-on.spice-opt-2 { border-color: #E0533F; background: #FFEDE8; }
.spice-opt-on.spice-opt-3 { border-color: #D42B2B; background: #FFE7E4; }

.spice-opt-on .so-txt {
  color: #D42B2B;
}

.spice-opt-on.spice-opt-0 .so-txt {
  color: #8A7772;
}

.sheet-btn {
  width: 100%;
}
