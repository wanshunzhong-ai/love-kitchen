<view class="page">
  <!-- 顶部问候（按身份换文案 + 身份胶囊） -->
  <view class="hero">
    <view class="hero-text">
      <view class="hero-title">{{role === 'cook' ? '大厨今天掌勺～' : '今天想吃点什么？'}}</view>
      <view class="hero-sub">{{role === 'cook' ? '菜单由你打理，等TA来点单 💕' : '选好后交给大厨吧 💕'}}</view>
    </view>
    <view class="hero-right">
      <view class="hero-role" bindtap="goProfile">{{roleInfo.emoji}} {{roleInfo.text}}</view>
      <view class="hero-add" bindtap="goAddDish">＋ 加菜</view>
    </view>
  </view>

  <!-- 搜索 -->
  <view class="search {{searchFocus ? 'search-on' : ''}}">
    <text class="search-icon">🔍</text>
    <input
      class="search-input"
      value="{{keyword}}"
      placeholder="搜菜名、食材、分类…"
      placeholder-class="search-ph"
      confirm-type="search"
      bindinput="onSearchInput"
      bindfocus="onSearchFocus"
      bindblur="onSearchBlur"
    />
    <text wx:if="{{keyword}}" class="search-clear" bindtap="clearSearch">✕</text>
  </view>

  <!-- 分类 -->
  <scroll-view class="cats" scroll-x enhanced="{{true}}" show-scrollbar="{{false}}">
    <view
      class="cat {{activeCategory === item.key ? 'cat-active' : ''}}"
      wx:for="{{categories}}"
      wx:key="key"
      data-cat="{{item.key}}"
      bindtap="onTapCategory"
    >{{item.emoji}} {{item.key}}</view>
  </scroll-view>

  <!-- 菜品列表 -->
  <view wx:if="{{loading}}" class="state">
    <text class="state-emoji">🍽️</text>
    <text class="state-tip">正在摆盘…</text>
  </view>

  <view wx:elif="{{loadError}}" class="state">
    <text class="state-emoji">😵</text>
    <text class="state-tip">菜单没加载出来，网络可能开小差了</text>
    <button class="btn-retry" bindtap="loadDishes">重试</button>
  </view>

  <!-- 搜不到（有菜单但没匹配） -->
  <view wx:elif="{{dishes.length > 0 && filteredDishes.length === 0}}" class="state">
    <text class="state-emoji">🔍</text>
    <text class="state-tip">没找到「{{keyword}}」{{activeCategory === '全部' ? '' : '（' + activeCategory + '）'}}</text>
    <text class="state-sub">换个词试试，或者看看全部菜单</text>
    <button class="btn-retry" bindtap="clearSearch">看看全部菜单</button>
  </view>

  <!-- 菜单本身是空的 -->
  <view wx:elif="{{dishes.length === 0}}" class="state">
    <text class="state-emoji">🍳</text>
    <text class="state-tip">菜单还是空的，点「加菜」放第一道菜进来吧</text>
    <button class="btn-retry" bindtap="goAddDish">去加菜</button>
  </view>

  <view wx:else class="dish-list">
    <view wx:if="{{keyword}}" class="result-hint">
      找到 <text class="result-num">{{filteredDishes.length}}</text> 道菜
    </view>

    <view class="dish card" wx:for="{{filteredDishes}}" wx:key="id">
      <view class="dish-emoji">{{item.emoji}}</view>
      <view class="dish-info" data-idx="{{index}}" bindtap="onDishTap">
        <view class="dish-name-row">
          <view class="dish-name">{{item.name}}</view>
          <text class="dish-spice spice-{{item.spiceIdx}}">{{item.spiceText}}</text>
        </view>
        <view class="dish-desc" wx:if="{{item.description}}">{{item.description}}</view>
      </view>
      <view wx:if="{{!isCook}}" class="dish-add" data-idx="{{index}}" catchtap="onAddTap">＋</view>
    </view>
  </view>

  <!-- 随机帮选（点菜功能，做饭人不显示） -->
  <view wx:if="{{!isCook}}" class="lucky" bindtap="onRandom">🎲 今天吃什么</view>

  <!-- 购物车栏（做饭人不显示，切身份时购物车已清空） -->
  <view class="cart-bar" wx:if="{{cartCount > 0 && !isCook}}" bindtap="goCart">
    <view class="cart-badge">{{cartCount}}</view>
    <text class="cart-label">已选好菜</text>
    <view class="cart-go">去下单</view>
  </view>

  <!-- 辣度选择弹层 -->
  <view wx:if="{{spicePicker.open}}" class="mask" bindtap="closeSpicePicker">
    <view class="sheet" catchtap="noop">
      <view class="sheet-head">
        <view class="sheet-dish">
          <text class="sheet-emoji">{{spicePicker.dish.emoji}}</text>
          <text class="sheet-name">{{spicePicker.dish.name}}</text>
        </view>
        <text class="sheet-close" bindtap="closeSpicePicker">✕</text>
      </view>

      <view class="sheet-tip">
        想吃什么辣度？<text class="sheet-tip-sub">（推荐 {{spicePicker.dish.spice || '不辣'}}）</text>
      </view>

      <view class="spice-opts">
        <view
          class="spice-opt spice-opt-{{item.level}} {{spicePicker.selected === item.key ? 'spice-opt-on' : ''}}"
          wx:for="{{spicePicker.levels}}"
          wx:key="key"
          data-spice="{{item.key}}"
          bindtap="onPickSpice"
        >
          <text class="so-txt">{{item.key}}</text>
          <text class="so-chili">{{item.level > 0 ? '🌶️' : '🚫'}}</text>
        </view>
      </view>

      <button class="btn-main sheet-btn" bindtap="confirmAdd">加入购物车 🛒</button>
    </view>
  </view>
</view>
