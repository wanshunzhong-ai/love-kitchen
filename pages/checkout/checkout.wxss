/* 确认订单页 */
.page {
  padding: 24rpx 24rpx 80rpx;
  /* 底部安全区：不是 tab 页，只需避开全面屏手势条 */
  padding-bottom: 80rpx;
  padding-bottom: calc(40rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.section {
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #4A3B38;
  margin-bottom: 20rpx;
}

.section-hint {
  font-size: 22rpx;
  font-weight: 400;
  color: #C4B2AC;
}

/* 输入框 */
.input {
  background: #FFFBF9;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
}

.textarea {
  background: #FFFBF9;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  width: 100%;
  box-sizing: border-box;
  min-height: 120rpx;
}

.ph {
  color: #D8C7C1;
}

/* 忌口清单卡片的样式是跨页共用的（结算页 / 编辑订单页），见 app.wxss 的 .avoid-* */

/* 提交 */
.submit {
  margin-top: 16rpx;
  line-height: 96rpx;
  font-size: 30rpx;
}
