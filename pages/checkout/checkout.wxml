<view class="page">
  <!-- 空购物车（统一走 state-block 组件，视觉见 styles/state.wxss） -->
  <state-block
    wx:if="{{cart.length === 0}}"
    emoji="🛒"
    tip="购物车空空的，去挑点好吃的吧"
    retry="去点单"
    bind:retry="goBackMenu"
  />

  <block wx:else>
    <!-- 菜品清单 -->
    <view class="card section">
      <view class="section-title">🧺 选好的菜<text class="section-hint">（点辣度改口味，点备注写要求）</text></view>

      <!-- 菜品行统一由 cart-list 组件渲染（与编辑订单页共用同一份结构 / 样式） -->
      <cart-list
        items="{{cart}}"
        spice-levels="{{spiceLevels}}"
        open-key="{{spiceOpenUid}}"
        add-text="＋ 再加几个菜"
        bind:act="onCartAct"
        bind:add="goBackMenu"
      />
    </view>

    <!-- 用餐时间 -->
    <view class="card section">
      <view class="section-title">📅 什么时候吃<text class="section-hint">（最多提前一周定）</text></view>

      <scroll-view class="dine-dates" scroll-x enhanced="{{true}}" show-scrollbar="{{false}}">
        <view
          class="dine-chip {{dineDate === d.value ? 'dine-chip-on' : ''}} {{d.disabled ? 'dine-chip-off' : ''}}"
          wx:for="{{dineDates}}"
          wx:for-item="d"
          wx:key="value"
          data-value="{{d.value}}"
          bindtap="onPickDineDate"
        >
          <text class="dc-label">{{d.label}}</text>
          <text class="dc-sub">{{d.sub}}</text>
        </view>
      </scroll-view>

      <view class="dine-slots">
        <view
          class="dine-chip dine-chip-wide {{dineSlot === s.key ? 'dine-chip-on' : ''}} {{s.disabled ? 'dine-chip-off' : ''}}"
          wx:for="{{dineSlots}}"
          wx:for-item="s"
          wx:key="key"
          data-key="{{s.key}}"
          bindtap="onPickDineSlot"
        >{{s.emoji}} {{s.text}}<text class="dc-end">{{s.endText}}</text></view>
      </view>
    </view>

    <!-- 谁点的 -->
    <view class="card section">
      <view class="section-title">🙋 谁点的</view>
      <input
        class="input"
        value="{{nickname}}"
        placeholder="比如：宝贝"
        placeholder-class="ph"
        maxlength="12"
        bindinput="onNickInput"
      />
    </view>

    <!-- 忌口清单：随订单一起送到掌勺人手上，TA 做菜时照着避雷 -->
    <view class="card section">
      <view class="section-title">🚫 我的忌口<text class="section-hint">（会一起告诉 TA）</text></view>

      <view class="avoid-wrap" wx:if="{{avoids.length > 0}}">
        <view class="avoid-chip" wx:for="{{avoids}}" wx:key="*this">{{item}}</view>
      </view>
      <view class="avoid-none" wx:else>还没记忌口 · 掌勺人不知道你不吃什么</view>

      <view class="avoid-add" bindtap="onAddAvoid">
        <text>＋ 记一条</text>
        <text class="avoid-count">{{avoids.length}}/{{avoidMax}}</text>
      </view>
    </view>

    <!-- 备注 -->
    <view class="card section">
      <view class="section-title">💬 想对掌勺人说<text class="section-hint">（整单的话；单道菜的要求点 ✏️ 写）</text></view>
      <textarea
        class="textarea"
        value="{{remark}}"
        placeholder="忌口、几点到家、想说的话…（可不填）"
        placeholder-class="ph"
        maxlength="100"
        bindinput="onRemarkInput"
      />
    </view>

    <button class="btn-main submit" disabled="{{submitting}}" bindtap="onSubmit">下单给掌勺人 🧑‍🍳（{{totalCount}} 道菜）</button>
  </block>

  <!-- 逐道菜修改：辣度 / 备注 / 换一道菜 -->
  <dish-editor
    wx:if="{{editorOpen}}"
    item="{{editorItem}}"
    bind:change="onEditorChange"
    bind:close="closeEditor"
  />
</view>
