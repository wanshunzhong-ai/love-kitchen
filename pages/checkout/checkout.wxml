<view class="page">
  <view wx:if="{{cart.length === 0}}" class="state">
    <text class="state-emoji">🛒</text>
    <text class="state-tip">购物车空空的，去挑点好吃的吧</text>
    <button class="btn-retry" bindtap="goBackMenu">去点菜</button>
  </view>

  <block wx:else>
    <!-- 菜品清单 -->
    <view class="card section">
      <view class="section-title">🧺 选好的菜<text class="section-hint">（辣度可以逐道改）</text></view>

      <view class="cart-item" wx:for="{{cart}}" wx:key="key">
        <view class="ci-main">
          <text class="ci-emoji">{{item.emoji}}</text>
          <view class="ci-info">
            <text class="ci-name">{{item.name}}</text>
            <!-- 辣度选择：点一下直接切换 -->
            <view class="ci-spices">
              <text
                class="ci-chip {{item.spice === sp ? 'ci-chip-on' : ''}}"
                wx:for="{{spiceLevels}}"
                wx:for-item="sp"
                wx:key="key"
                data-key="{{item.key}}"
                data-spice="{{sp.key}}"
                catchtap="onTapSpice"
              >{{sp.key}}</text>
            </view>
          </view>
        </view>

        <view class="ci-actions">
          <view class="ci-stepper">
            <view class="step" data-key="{{item.key}}" data-delta="-1" catchtap="onQtyChange">−</view>
            <text class="step-num">{{item.qty}}</text>
            <view class="step step-plus" data-key="{{item.key}}" data-delta="1" catchtap="onQtyChange">＋</view>
          </view>
          <text class="ci-remove" data-key="{{item.key}}" catchtap="onRemoveItem">✕</text>
        </view>
      </view>
    </view>

    <!-- 用餐时间 -->
    <view class="card section">
      <view class="section-title">📅 什么时候吃<text class="section-hint">（最多提前一周定）</text></view>

      <scroll-view class="dine-dates" scroll-x enhanced="{{true}}" show-scrollbar="{{false}}">
        <view
          class="dine-chip {{dineDate === d.value ? 'dine-chip-on' : ''}}"
          wx:for="{{dineDates}}"
          wx:for-item="d"
          wx:key="value"
          data-value="{{d.value}}"
          bindtap="onPickDineDate"
        >
          <text class="dc-label">{{d.label}}</text>
          <text class="dc-sub">{{d.sub}}</text>
        </view>
      </scroll-view>

      <view class="dine-slots">
        <view
          class="dine-chip dine-chip-wide {{dineSlot === s.key ? 'dine-chip-on' : ''}} {{s.disabled ? 'dine-chip-off' : ''}}"
          wx:for="{{dineSlots}}"
          wx:for-item="s"
          wx:key="key"
          data-key="{{s.key}}"
          bindtap="onPickDineSlot"
        >{{s.emoji}} {{s.text}}</view>
      </view>
    </view>

    <!-- 点菜人 -->
    <view class="card section">
      <view class="section-title">🙋 谁点的</view>
      <input
        class="input"
        value="{{nickname}}"
        placeholder="比如：宝贝"
        placeholder-class="ph"
        maxlength="12"
        bindinput="onNickInput"
      />
    </view>

    <!-- 备注 -->
    <view class="card section">
      <view class="section-title">💬 想对大厨说</view>
      <textarea
        class="textarea"
        value="{{remark}}"
        placeholder="辣度、忌口、想说的话…（可不填）"
        placeholder-class="ph"
        maxlength="100"
        bindinput="onRemarkInput"
      />
    </view>

    <button class="btn-main submit" disabled="{{submitting}}" bindtap="onSubmit">下单给大厨 👨‍🍳（{{totalCount}} 道菜）</button>
  </block>
</view>
