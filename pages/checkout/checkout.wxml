<view class="page">
  <view wx:if="{{cart.length === 0}}" class="state">
    <text class="state-emoji">🛒</text>
    <text class="state-tip">购物车空空的，去挑点好吃的吧</text>
    <button class="btn-retry" bindtap="goBackMenu">去点菜</button>
  </view>

  <block wx:else>
    <!-- 菜品清单 -->
    <view class="card section">
      <view class="section-title">🧺 选好的菜<text class="section-hint">（点辣度改口味，点备注写要求）</text></view>

      <view class="cart-item" wx:for="{{cart}}" wx:key="uid">
        <view class="ci-main">
          <text class="ci-emoji">{{item.emoji}}</text>
          <view class="ci-info">
            <view class="ci-name-row">
              <text class="ci-name">{{item.name}}</text>
              <!-- 打开「改这道菜」面板：辣度 / 备注 / 换菜 -->
              <text class="ci-edit" data-uid="{{item.uid}}" catchtap="openEditor">✏️</text>
            </view>
            <!-- 辣度：平时只显示当前选定的那一档，点一下就地展开四档重选 -->
            <view class="ci-spice">
              <view
                wx:if="{{spiceOpenUid !== item.uid}}"
                class="ci-spice-cur splv-{{item.spiceLevel}}"
                data-uid="{{item.uid}}"
                catchtap="onOpenSpice"
              >
                <text>{{item.spiceLabel}}</text>
                <text class="csc-caret">▾</text>
              </view>
              <view wx:else class="ci-spices">
                <text
                  class="ci-chip {{item.spice === sp ? 'ci-chip-on' : ''}}"
                  wx:for="{{spiceLevels}}"
                  wx:for-item="sp"
                  wx:key="key"
                  data-uid="{{item.uid}}"
                  data-spice="{{sp.key}}"
                  catchtap="onTapSpice"
                >{{sp.key}}</text>
              </view>
            </view>
            <!-- 这一道菜的备注：点一下就写，不用打开面板 -->
            <view
              class="ci-note {{item.note ? '' : 'ci-note-empty'}}"
              data-uid="{{item.uid}}"
              catchtap="onTapNote"
            >{{item.note ? '📝 ' + item.note : '＋ 写一句这道菜的备注'}}</view>
          </view>
        </view>

        <view class="ci-actions">
          <view class="ci-stepper">
            <view class="step" data-uid="{{item.uid}}" data-delta="-1" catchtap="onQtyChange">−</view>
            <text class="step-num">{{item.qty}}</text>
            <view class="step step-plus" data-uid="{{item.uid}}" data-delta="1" catchtap="onQtyChange">＋</view>
          </view>
          <text class="ci-remove" data-uid="{{item.uid}}" catchtap="onRemoveItem">✕</text>
        </view>
      </view>

      <view class="add-more" bindtap="goBackMenu">＋ 再加几个菜</view>
    </view>

    <!-- 用餐时间 -->
    <view class="card section">
      <view class="section-title">📅 什么时候吃<text class="section-hint">（最多提前一周定）</text></view>

      <scroll-view class="dine-dates" scroll-x enhanced="{{true}}" show-scrollbar="{{false}}">
        <view
          class="dine-chip {{dineDate === d.value ? 'dine-chip-on' : ''}}"
          wx:for="{{dineDates}}"
          wx:for-item="d"
          wx:key="value"
          data-value="{{d.value}}"
          bindtap="onPickDineDate"
        >
          <text class="dc-label">{{d.label}}</text>
          <text class="dc-sub">{{d.sub}}</text>
        </view>
      </scroll-view>

      <view class="dine-slots">
        <view
          class="dine-chip dine-chip-wide {{dineSlot === s.key ? 'dine-chip-on' : ''}} {{s.disabled ? 'dine-chip-off' : ''}}"
          wx:for="{{dineSlots}}"
          wx:for-item="s"
          wx:key="key"
          data-key="{{s.key}}"
          bindtap="onPickDineSlot"
        >{{s.emoji}} {{s.text}}</view>
      </view>
    </view>

    <!-- 点菜人 -->
    <view class="card section">
      <view class="section-title">🙋 谁点的</view>
      <input
        class="input"
        value="{{nickname}}"
        placeholder="比如：宝贝"
        placeholder-class="ph"
        maxlength="12"
        bindinput="onNickInput"
      />
    </view>

    <!-- 备注 -->
    <view class="card section">
      <view class="section-title">💬 想对大厨说<text class="section-hint">（整单的话；单道菜的要求点 ✏️ 写）</text></view>
      <textarea
        class="textarea"
        value="{{remark}}"
        placeholder="忌口、几点到家、想说的话…（可不填）"
        placeholder-class="ph"
        maxlength="100"
        bindinput="onRemarkInput"
      />
    </view>

    <button class="btn-main submit" disabled="{{submitting}}" bindtap="onSubmit">下单给大厨 👨‍🍳（{{totalCount}} 道菜）</button>
  </block>

  <!-- 逐道菜修改：辣度 / 备注 / 换一道菜 -->
  <dish-editor
    wx:if="{{editorOpen}}"
    item="{{editorItem}}"
    bind:change="onEditorChange"
    bind:close="closeEditor"
  />
</view>
