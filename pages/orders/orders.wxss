/* 订单页 */
.page {
  padding: 24rpx 24rpx 24rpx;
  /* 底部留白让开自定义 tabBar（110rpx + 安全区）+ 余量 */
  padding-bottom: 200rpx;
  padding-bottom: calc(150rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(150rpx + env(safe-area-inset-bottom));
}

/* 身份胶囊 + 筛选行 */
.filters-row {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.filters {
  flex: 1;
  min-width: 0;
  white-space: nowrap;
}

.role-chip {
  flex-shrink: 0;
  margin-left: 14rpx;
  background: #ffffff;
  border: 2rpx solid #F6E3DC;
  border-radius: var(--radius-pill);
  padding: 10rpx 22rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #8A7772;
}

.order-wait {
  font-size: 22rpx;
  color: #C9B6AF;
  margin-right: 8rpx;
}

.fchip {
  display: inline-block;
  padding: 12rpx 30rpx;
  margin-right: 16rpx;
  background: #ffffff;
  border-radius: var(--radius-pill);
  font-size: 26rpx;
  color: #8A7772;
  border: 2rpx solid #F6E3DC;
}

.fchip-active {
  background: var(--grad-main);
  color: #ffffff;
  border-color: transparent;
  font-weight: 600;
}

/* 订单卡片 */
.order {
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.order-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.order-dine {
  font-size: 24rpx;
  color: #E08A4B;
  background: #FFF3EA;
  border-radius: 12rpx;
  padding: 10rpx 20rpx;
  margin-bottom: 16rpx;
  display: inline-block;
}

.order-from {
  font-size: 28rpx;
  font-weight: 600;
  color: #4A3B38;
}

.order-status {
  padding: 8rpx 20rpx;
  border-radius: var(--radius-pill);
  font-size: 24rpx;
  font-weight: 600;
}

.s-pending {
  background: #FFF3E5;
  color: #D9822B;
}

.s-cooking {
  background: #FFE9EE;
  color: #E85C8A;
}

.s-done {
  background: #E8F9EE;
  color: #1FA65A;
}

/* 已驳回：灰蓝一点，跟「做完了」的绿区分开，一眼看出这不是进行中的单 */
.s-rejected {
  background: #EEF1F6;
  color: #6B7B95;
}

/* 菜品明细 */
.order-items {
  background: #FFFBF9;
  border-radius: 16rpx;
  padding: 16rpx 24rpx;
}

.order-item {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 10rpx 0;
  font-size: 28rpx;
  color: #6B5854;
}

.order-qty {
  color: #B9A29B;
  flex-shrink: 0;
  padding-left: 16rpx;
}

.oi-left {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  flex: 1;
  min-width: 0;
}

.oi-line {
  display: flex;
  align-items: center;
  min-width: 0;
}

/* 这一道菜的单独备注 */
.oi-note {
  margin-top: 4rpx;
  font-size: 22rpx;
  line-height: 1.4;
  color: #C08A7A;
  word-break: break-all;
}

/* 干饭人对这一道菜的评价：浅绿底，和「已上菜」同色系，一眼认出是反馈 */
.oi-review {
  width: 100%;
  margin-top: 8rpx;
  background: #F1FAF4;
  border-left: 6rpx solid #A8E0BF;
  border-radius: 10rpx;
  padding: 10rpx 16rpx;
  box-sizing: border-box;
}

.oir-top {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.oir-stars {
  font-size: 26rpx;
  line-height: 1.2;
  color: #FFB300;
  letter-spacing: 2rpx;
}

.oir-dim {
  font-size: 26rpx;
  line-height: 1.2;
  color: #DCE8E0;
  letter-spacing: 2rpx;
}

.oir-label {
  margin-left: 12rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #1FA65A;
}

.oir-tags {
  display: flex;
  flex-wrap: wrap;
  margin: 4rpx -5rpx -5rpx;
}

.oir-tag {
  margin: 5rpx;
  font-size: 22rpx;
  line-height: 34rpx;
  color: #1FA65A;
  background: #E2F5E9;
  border-radius: var(--radius-pill);
  padding: 0 14rpx;
}

.oir-text {
  margin-top: 6rpx;
  font-size: 23rpx;
  line-height: 1.5;
  color: #3E7A57;
  word-break: break-all;
}

/* 已上菜单的评价进度条 */
.order-review-bar {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  background: #F1FAF4;
  border-radius: 12rpx;
  padding: 12rpx 20rpx;
}

.orb-emoji {
  font-size: 24rpx;
  margin-right: 10rpx;
}

.orb-text {
  font-size: 23rpx;
  font-weight: 600;
  color: #1FA65A;
}

/* 辣度标签：与点单页同配色；字号下限 22rpx */
.oi-spice {
  margin-left: 12rpx;
  padding: 2rpx 12rpx;
  border-radius: var(--radius-pill);
  font-size: 22rpx;
  line-height: 32rpx;
  flex-shrink: 0;
}

/* 辣度皮肤（.spice-0 ~ .spice-3）已收进 styles/common.wxss。
   原先五个页面各写一份（待做页那份还漂移过色值），同一档辣度会显示成两种颜色。 */
.order-remark {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #C97B8E;
  background: #FFF0F4;
  border-radius: 12rpx;
  padding: 14rpx 20rpx;
}

/* 驳回提示：理由要看得见，所以给它一块比备注更重的底 */
.order-reject {
  display: flex;
  align-items: flex-start;
  margin-top: 16rpx;
  padding: 18rpx 22rpx;
  background: #F5F7FB;
  border: 2rpx solid #E3E8F1;
  border-radius: 16rpx;
}

.orj-emoji {
  font-size: 34rpx;
  line-height: 42rpx;
  padding-right: 16rpx;
  flex-shrink: 0;
}

.orj-main {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-width: 0;
}

.orj-title {
  font-size: 24rpx;
  color: #6B7B95;
}

.orj-reason {
  margin-top: 6rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #46536B;
  word-break: break-all;
}

.orj-hint {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #9AA6B8;
}

.order-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
}

.order-time {
  font-size: 22rpx;
  color: #B9A29B;
}

.order-actions {
  display: flex;
  align-items: center;
}

.act {
  padding: 12rpx 30rpx;
  border-radius: var(--radius-pill);
  font-size: 26rpx;
  margin-left: 16rpx;
}

.act-ghost {
  border: 2rpx solid #EAD9D3;
  color: #8A7772;
}

/* 编辑按钮：多个按钮并排时收窄一点，避免换行 */
.order-actions .act-ghost {
  padding: 12rpx 18rpx;
  font-size: 23rpx;
}

.order-actions .act-main {
  padding: 12rpx 22rpx;
  font-size: 23rpx;
}

/* 删除按钮：描边弱化，避免误触；点了还有二次确认兜底 */
.act-danger {
  border: 2rpx solid #F3D2D8;
  color: #C96A80;
}

.order-actions .act-danger {
  padding: 12rpx 18rpx;
  font-size: 23rpx;
}

/* 按钮多了以后允许换行，窄屏也不会挤成一团 */
.order-actions {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
}

.act-main {
  background: var(--grad-main);
  color: #ffffff;
  font-weight: 600;
}
