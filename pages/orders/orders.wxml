<view class="page">
  <!-- 身份胶囊 + 状态筛选 -->
  <view class="filters-row">
    <scroll-view class="filters" scroll-x enhanced="{{true}}" show-scrollbar="{{false}}">
      <view
        class="fchip {{activeFilter === item.key ? 'fchip-active' : ''}}"
        wx:for="{{filters}}"
        wx:key="key"
        data-key="{{item.key}}"
        bindtap="onFilterTap"
      >{{item.emoji}} {{item.key === '全部' ? '全部' : statusMap[item.key].text}}</view>
    </scroll-view>
    <view class="role-chip" bindtap="goProfile">{{roleInfo.emoji}} {{roleInfo.text}}</view>
  </view>

  <!-- 订单列表 -->
  <view wx:if="{{loading}}" class="state">
    <text class="state-emoji">📋</text>
    <text class="state-tip">正在看看厨房…</text>
  </view>

  <view wx:elif="{{loadError}}" class="state">
    <text class="state-emoji">🍽️</text>
    <text class="state-tip">订单没加载出来</text>
    <text class="state-sub">菜单已经可以正常用了；订单走的是云数据库，网络恢复后点「重试」即可</text>
    <button class="btn-retry" bindtap="loadOrders">重试</button>
  </view>

  <view wx:elif="{{filteredOrders.length === 0}}" class="state">
    <text class="state-emoji">🛎️</text>
    <text class="state-tip">{{isCook ? '还没有订单，等TA来点单～' : '还没有订单，去点几个菜吧～'}}</text>
    <button wx:if="{{!isCook}}" class="btn-retry" bindtap="goMenu">去点单</button>
  </view>

  <view wx:else class="order-list">
    <view class="order card" wx:for="{{filteredOrders}}" wx:key="id">
      <view class="order-head">
        <text class="order-from">来自 {{item.order_by}}</text>
        <text class="order-status s-{{item.status}}">{{statusMap[item.status].emoji}} {{statusMap[item.status].text}}</text>
      </view>

      <view class="order-dine">📅 {{item.dineText}}</view>

      <view class="order-items">
        <view class="order-item" wx:for="{{item.items}}" wx:for-item="dish" wx:key="rowKey">
          <view class="oi-left">
            <view class="oi-line">
              <text>{{dish.emoji}} {{dish.name}}</text>
              <text class="oi-spice spice-{{dish.spiceIdx}}">{{dish.spiceText}}</text>
            </view>
            <!-- 这一道菜的单独备注 -->
            <view class="oi-note" wx:if="{{dish.note}}">📝 {{dish.note}}</view>
          </view>
          <text class="order-qty">× {{dish.qty}}</text>
        </view>
      </view>

      <view class="order-remark" wx:if="{{item.remark}}">💬 {{item.remark}}</view>

      <view class="order-foot">
        <text class="order-time">{{item.timeText}}</text>
        <view class="order-actions">
          <!-- 状态推进是做饭人的活：只有做饭人看得到这两个按钮 -->
          <block wx:if="{{isCook}}">
            <view wx:if="{{item.status === 'pending'}}" class="act act-main" data-idx="{{index}}" catchtap="onStartCooking">开始做</view>
            <view wx:if="{{item.status === 'cooking'}}" class="act act-main" data-idx="{{index}}" catchtap="onFinishCooking">做好了</view>
          </block>
          <text wx:elif="{{item.status !== 'done'}}" class="order-wait">等大厨开做哦</text>
          <!-- 已上菜的订单是终态：只留「删掉」，不给编辑入口 -->
          <view wx:if="{{item.status !== 'done'}}" class="act act-ghost" data-idx="{{index}}" catchtap="onEditOrder">✏️ 编辑</view>
          <view class="act act-danger" data-idx="{{index}}" catchtap="onDeleteOrder">🗑️ 删掉</view>
        </view>
      </view>
    </view>
  </view>
</view>
