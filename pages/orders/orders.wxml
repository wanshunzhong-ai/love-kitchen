<view class="page">
  <!-- 轮询发现变化时浮出来的一句话（6 秒后自己消失，点一下去对应页面） -->
  <view class="notice" wx:if="{{notice}}" bindtap="onTapNotice">
    <text class="notice-emoji">{{notice.emoji}}</text>
    <text class="notice-text">{{notice.text}}</text>
    <text class="notice-go" wx:if="{{notice.path !== '/pages/orders/orders'}}">去看看 ›</text>
  </view>

  <!-- 身份胶囊 + 状态筛选 -->
  <view class="filters-row">
    <scroll-view class="filters" scroll-x enhanced="{{true}}" show-scrollbar="{{false}}">
      <view
        class="fchip {{activeFilter === item.key ? 'fchip-active' : ''}}"
        wx:for="{{filters}}"
        wx:key="key"
        data-key="{{item.key}}"
        bindtap="onFilterTap"
      >{{item.emoji}} {{item.key === '全部' ? '全部' : statusMap[item.key].text}}</view>
    </scroll-view>
    <view class="role-chip" bindtap="goProfile">{{roleInfo.emoji}} {{roleInfo.text}}</view>
  </view>

  <!-- 订单列表 -->
  <view wx:if="{{loading}}" class="state">
    <text class="state-emoji">📋</text>
    <text class="state-tip">正在看看厨房…</text>
  </view>

  <view wx:elif="{{loadError}}" class="state">
    <text class="state-emoji">🍽️</text>
    <text class="state-tip">订单没加载出来</text>
    <text class="state-sub">菜单已经可以正常用了；订单走的是云数据库，网络恢复后点「重试」即可</text>
    <button class="btn-retry" bindtap="onRetry">重试</button>
  </view>

  <view wx:elif="{{filteredOrders.length === 0}}" class="state">
    <text class="state-emoji">🛎️</text>
    <text class="state-tip">{{isCook ? '还没有订单，等TA来点单～' : '还没有订单，去点几个菜吧～'}}</text>
    <button wx:if="{{!isCook}}" class="btn-retry" bindtap="goMenu">去点单</button>
  </view>

  <view wx:else class="order-list">
    <view class="order card" wx:for="{{filteredOrders}}" wx:key="id">
      <view class="order-head">
        <text class="order-from">来自 {{item.order_by}}</text>
        <text class="order-status s-{{item.status}}">{{statusMap[item.status].emoji}} {{statusMap[item.status].text}}</text>
      </view>

      <!-- 忌口：掌勺人做菜前最该扫一眼的一行（TA 没记就不出这一条） -->
      <view class="order-avoids" wx:if="{{item.avoidsText}}">🚫 TA 不吃：{{item.avoidsText}}</view>

      <view class="order-dine">📅 {{item.dineText}}</view>

      <view class="order-items">
        <view class="order-item" wx:for="{{item.items}}" wx:for-item="dish" wx:key="rowKey">
          <view class="oi-left">
            <view class="oi-line">
              <text>{{dish.emoji}} {{dish.name}}</text>
              <text class="oi-spice spice-{{dish.spiceIdx}}">{{dish.spiceText}}</text>
            </view>
            <!-- 这一道菜的单独备注 -->
            <view class="oi-note" wx:if="{{dish.note}}">📝 {{dish.note}}</view>
            <!-- 干饭人对这一道菜的评价（掌勺人在这里看到 TA 的反馈） -->
            <view class="oi-review" wx:if="{{dish.review}}">
              <view class="oir-top">
                <text class="oir-stars">{{dish.starFull}}</text>
                <text class="oir-dim">{{dish.starDim}}</text>
                <text class="oir-label">{{dish.ratingLabel}}</text>
              </view>
              <view class="oir-tags" wx:if="{{dish.review.tags.length}}">
                <text class="oir-tag" wx:for="{{dish.review.tags}}" wx:for-item="tg" wx:key="*this">{{tg}}</text>
              </view>
              <view class="oir-text" wx:if="{{dish.review.text}}">「{{dish.review.text}}」</view>
            </view>
          </view>
          <text class="order-qty">× {{dish.qty}}</text>
        </view>
      </view>

      <view class="order-remark" wx:if="{{item.remark}}">💬 {{item.remark}}</view>

      <!-- 被驳回：理由摆在最显眼处（干饭人看到的是「为什么不做」，不是一个冷冰冰的状态） -->
      <view class="order-reject" wx:if="{{item.status === 'rejected'}}">
        <text class="orj-emoji">🙅</text>
        <view class="orj-main">
          <text class="orj-title">掌勺人说先不做这一单</text>
          <text class="orj-reason">「{{item.rejectText}}」</text>
          <text class="orj-hint">{{isCook ? '等 TA 改好再交回来' : '改一改再交回去，或者删掉它'}}</text>
        </view>
      </view>

      <!-- 已上菜的单：评价进度一览 -->
      <view class="order-review-bar" wx:if="{{item.status === 'done' && item.reviewSummary.any}}">
        <text class="orb-emoji">⭐</text>
        <text class="orb-text">平均 {{item.reviewSummary.avgText}} 分 · 已评 {{item.reviewSummary.rated}}/{{item.reviewSummary.total}} 道</text>
      </view>

      <view class="order-foot">
        <text class="order-time">{{item.timeText}}</text>
        <view class="order-actions">
          <!-- 掌勺人：这一单只推进状态或驳回，改内容不给入口 -->
          <block wx:if="{{isCook}}">
            <view wx:if="{{item.status === 'pending'}}" class="act act-main" data-idx="{{index}}" catchtap="onStartCooking">开始做</view>
            <view wx:elif="{{item.status === 'cooking'}}" class="act act-main" data-idx="{{index}}" catchtap="onFinishCooking">做好了</view>
            <view wx:if="{{item.canReject}}" class="act act-ghost" data-idx="{{index}}" catchtap="onReject">🙅 驳回</view>
            <view wx:if="{{item.status === 'rejected'}}" class="act act-ghost" data-idx="{{index}}" catchtap="onWithdrawReject">↩️ 收回驳回</view>
          </block>

          <!-- 干饭人：改单 / 删单 / 评价；状态不归他管 -->
          <block wx:else>
            <text wx:if="{{item.status === 'pending'}}" class="order-wait">等掌勺人开做哦</text>
            <!-- 开做中 = 掌勺人已经开火：不给编辑入口，免得改了白改 -->
            <text wx:elif="{{item.status === 'cooking'}}" class="order-wait">掌勺人正在做，先别改单啦</text>
            <view
              wx:if="{{item.status === 'done'}}"
              class="act act-main"
              data-idx="{{index}}"
              catchtap="onReview"
            >{{item.reviewSummary.any ? '✏️ 改评价' : '🍽️ 去评价'}}</view>
            <!-- 可编辑的只有「待开做」和「已驳回」：开做中 / 已上菜都不给入口 -->
            <view
              wx:if="{{item.status === 'pending' || item.status === 'rejected'}}"
              class="act act-ghost"
              data-idx="{{index}}"
              catchtap="onEditOrder"
            >{{item.status === 'rejected' ? '✏️ 改好重交' : '✏️ 编辑'}}</view>
            <!-- 开做中 = 掌勺人正在做这顿饭：不能改也不能删，等做完再说 -->
            <view
              wx:if="{{item.status !== 'cooking'}}"
              class="act act-danger"
              data-idx="{{index}}"
              catchtap="onDeleteOrder"
            >🗑️ 删掉</view>
          </block>
        </view>
      </view>
    </view>
  </view>
</view>
