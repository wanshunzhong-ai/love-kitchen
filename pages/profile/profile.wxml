<view class="me">
  <!-- 头像卡：微信选头像 + 称呼 + 当前状态 -->
  <view class="me-card me-hero">
    <button class="me-avatar-btn" open-type="chooseAvatar" bind:chooseavatar="onChooseAvatar">
      <image wx:if="{{avatar}}" class="me-avatar-img" src="{{avatar}}" mode="aspectFill" />
      <text wx:else class="me-avatar">{{roleInfo.emoji}}</text>
      <view class="me-avatar-edit">📷 换头像</view>
    </button>
    <view class="me-identity">{{roleInfo.text}}</view>
    <view class="me-id-desc" wx:if="{{intro}}">{{intro}}</view>
    <view class="me-id-desc" wx:elif="{{moodInfo}}">{{moodInfo.emoji}} 现在{{moodInfo.text}}</view>
    <view class="me-id-desc" wx:else>写句介绍，选个状态，让TA看见</view>
  </view>

  <!-- 个人介绍 -->
  <view class="me-card">
    <view class="me-label">个人介绍</view>
    <view class="me-intro-row">
      <textarea
        class="me-intro-input"
        value="{{intro}}"
        maxlength="{{introMax}}"
        auto-height
        placeholder="一句话介绍自己，比如：爱吃甜，厨艺待考证"
        placeholder-class="me-ph"
        bindinput="onIntroInput"
        bindblur="saveIntro"
      />
      <text class="me-count">{{intro.length}}/{{introMax}}</text>
    </view>
    <view wx:if="{{introDirty}}" class="me-save" bindtap="saveIntro">保存一下</view>
  </view>

  <!-- 当前状态 -->
  <view class="me-card">
    <view class="me-label">当前状态</view>
    <view class="me-moods">
      <view
        class="me-mood {{moodKey === item.key ? 'me-mood-on' : ''}}"
        wx:for="{{moods}}"
        wx:key="key"
        data-key="{{item.key}}"
        bindtap="onMoodTap"
      >{{item.emoji}} {{item.text}}</view>
    </view>
  </view>

  <!-- 忌口清单 -->
  <view class="me-card">
    <view class="me-label">忌口清单 <text class="me-count">{{avoids.length}}/{{avoidMax}}</text></view>
    <view class="me-avoids" wx:if="{{avoids.length > 0}}">
      <view class="me-avoid" wx:for="{{avoids}}" wx:key="*this">
        {{item}}
        <text class="me-avoid-del" data-tag="{{item}}" catchtap="onRemoveAvoid">✕</text>
      </view>
    </view>
    <view class="me-tip" wx:else>还没有忌口，从下面挑几个，或自己输入</view>

    <view class="me-tags">
      <view
        class="me-tag"
        wx:for="{{commonTags}}"
        wx:key="*this"
        data-tag="{{item}}"
        bindtap="onCommonTagTap"
      >＋ {{item}}</view>
      <view class="me-tag me-tag-input" bindtap="onAddAvoid">✏️ 自己输入</view>
    </view>
    <view class="me-tip">掌勺前照着这份清单避雷，吃的放心</view>
  </view>

  <!-- 称呼 -->
  <view class="me-card">
    <view class="me-label">我的称呼</view>
    <view class="me-nick-row">
      <input
        class="me-nick-input"
        value="{{nickname}}"
        maxlength="{{nickMax}}"
        placeholder="比如：宝贝"
        placeholder-class="me-ph"
        bindinput="onNickInput"
        bindblur="saveNickname"
      />
      <text class="me-count">{{nickname.length}}/{{nickMax}}</text>
    </view>
    <view class="me-tip">下单时会显示在订单的「来自 xx」里</view>
    <view wx:if="{{dirty}}" class="me-save" bindtap="saveNickname">保存一下</view>
  </view>

  <!-- 身份 -->
  <view class="me-card">
    <view class="me-label">当前身份</view>
    <view class="me-role-row" bindtap="goRoleSelect">
      <text class="me-role-text">{{roleInfo.emoji}} {{roleInfo.text}}</text>
      <text class="me-role-switch">切换身份 →</text>
    </view>
    <view class="me-tip">换身份不影响已有订单；分工是：做饭人不点菜，点餐人不掌勺</view>
  </view>

  <view class="me-foot">💕 爱心小厨房 · 记录每一次开饭</view>
</view>
