/* 基本资料页：粉色系卡片，与全站风格一致 */
page {
  background: linear-gradient(180deg, #FFE9EE 0%, #FFF7F2 40%, #ffffff 100%);
}

.me {
  padding: 32rpx 32rpx 60rpx;
}

.me-card {
  background: #ffffff;
  border: 3rpx solid #F6E3DC;
  border-radius: 28rpx;
  padding: 36rpx 32rpx;
  margin-bottom: 28rpx;
  box-shadow: 0 8rpx 28rpx rgba(255, 122, 158, 0.08);
}

/* 头像卡 */
.me-hero {
  text-align: center;
  padding: 52rpx 32rpx 44rpx;
}

.me-avatar {
  font-size: 110rpx;
  line-height: 1;
}

.me-identity {
  margin-top: 20rpx;
  font-size: 40rpx;
  font-weight: 700;
  color: #4A3B38;
  letter-spacing: 2rpx;
}

.me-id-desc {
  margin-top: 12rpx;
  font-size: 25rpx;
  color: #B9A29B;
}

/* 卡片内区块 */
.me-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #8A7772;
  margin-bottom: 20rpx;
}

.me-nick-row {
  display: flex;
  align-items: center;
  background: #FFF7F2;
  border: 2rpx solid #F6E3DC;
  border-radius: 18rpx;
  padding: 0 24rpx;
}

.me-nick-input {
  flex: 1;
  height: 88rpx;
  font-size: 30rpx;
  color: #4A3B38;
}

.me-ph {
  color: #D9C6BF;
}

.me-count {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #C9B6AF;
}

.me-tip {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #C9B6AF;
  line-height: 1.6;
}

.me-save {
  margin-top: 20rpx;
  display: inline-block;
  background: linear-gradient(135deg, #FF7A9E, #FF9F43);
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 600;
  padding: 14rpx 40rpx;
  border-radius: 999rpx;
  box-shadow: 0 6rpx 16rpx rgba(255, 122, 158, 0.3);
}

/* 身份行 */
.me-role-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #FFF7F2;
  border: 2rpx solid #F6E3DC;
  border-radius: 18rpx;
  padding: 26rpx 24rpx;
}

.me-role-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #4A3B38;
}

.me-role-switch {
  font-size: 26rpx;
  font-weight: 600;
  color: #FF7A9E;
}

/* 底部 */
.me-foot {
  margin-top: 20rpx;
  text-align: center;
  font-size: 23rpx;
  color: #C9B6AF;
}
