/* 「我的」页：粉色系卡片，与全站风格一致 */
page {
  background: linear-gradient(180deg, #FFE9EE 0%, #FFF7F2 40%, #ffffff 100%);
}

.me {
  padding: 32rpx 32rpx 200rpx;
}

.me-card {
  background: #ffffff;
  border: 3rpx solid #F6E3DC;
  border-radius: 28rpx;
  padding: 36rpx 32rpx;
  margin-bottom: 28rpx;
  box-shadow: 0 8rpx 28rpx rgba(255, 122, 158, 0.08);
}

/* 头像卡 */
.me-hero {
  text-align: center;
  padding: 44rpx 32rpx 40rpx;
}

.me-avatar-btn {
  background: transparent;
  padding: 0;
  margin: 0 auto;
  line-height: 1;
  border: none;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 微信 button 自带边框，清掉 */
.me-avatar-btn::after {
  border: none;
}

.me-avatar {
  font-size: 110rpx;
  line-height: 1;
}

.me-avatar-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  border: 4rpx solid #FFD3E0;
  box-sizing: border-box;
}

.me-avatar-edit {
  margin-top: 14rpx;
  font-size: 22rpx;
  color: #FF7A9E;
  background: #FFE9EE;
  border-radius: 999rpx;
  padding: 6rpx 20rpx;
}

.me-identity {
  margin-top: 20rpx;
  font-size: 40rpx;
  font-weight: 700;
  color: #4A3B38;
  letter-spacing: 2rpx;
}

.me-id-desc {
  margin-top: 12rpx;
  font-size: 25rpx;
  color: #B9A29B;
}

/* 卡片内区块 */
.me-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #8A7772;
  margin-bottom: 20rpx;
}

.me-count {
  font-size: 22rpx;
  font-weight: 400;
  color: #C9B6AF;
  margin-left: 8rpx;
}

/* 当前状态 */
.me-moods {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.me-mood {
  background: #FFF7F2;
  border: 2rpx solid #F6E3DC;
  border-radius: 999rpx;
  padding: 12rpx 26rpx;
  font-size: 26rpx;
  color: #8A7772;
}

.me-mood-on {
  background: linear-gradient(135deg, #FF7A9E, #FF9F43);
  color: #ffffff;
  border-color: transparent;
  font-weight: 600;
}

/* 忌口清单 */
.me-avoids {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-bottom: 20rpx;
}

.me-avoid {
  display: flex;
  align-items: center;
  background: #FFF0F4;
  border: 2rpx solid #FFD3E0;
  border-radius: 999rpx;
  padding: 10rpx 14rpx 10rpx 22rpx;
  font-size: 25rpx;
  font-weight: 600;
  color: #B4435E;
}

.me-avoid-del {
  margin-left: 10rpx;
  width: 34rpx;
  height: 34rpx;
  line-height: 34rpx;
  text-align: center;
  border-radius: 50%;
  background: #FFD3E0;
  color: #ffffff;
  font-size: 20rpx;
}

.me-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.me-tag {
  background: #FFF7F2;
  border: 2rpx dashed #F0CFC6;
  border-radius: 999rpx;
  padding: 10rpx 22rpx;
  font-size: 24rpx;
  color: #B9A29B;
}

.me-tag-input {
  color: #FF7A9E;
  border-color: #FFB3C7;
  font-weight: 600;
}

/* 称呼 */
.me-nick-row {
  display: flex;
  align-items: center;
  background: #FFF7F2;
  border: 2rpx solid #F6E3DC;
  border-radius: 18rpx;
  padding: 0 24rpx;
}

.me-nick-input {
  flex: 1;
  height: 88rpx;
  font-size: 30rpx;
  color: #4A3B38;
}

.me-ph {
  color: #D9C6BF;
}

.me-tip {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #C9B6AF;
  line-height: 1.6;
}

.me-save {
  margin-top: 20rpx;
  display: inline-block;
  background: linear-gradient(135deg, #FF7A9E, #FF9F43);
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 600;
  padding: 14rpx 40rpx;
  border-radius: 999rpx;
  box-shadow: 0 6rpx 16rpx rgba(255, 122, 158, 0.3);
}

/* 身份行 */
.me-role-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #FFF7F2;
  border: 2rpx solid #F6E3DC;
  border-radius: 18rpx;
  padding: 26rpx 24rpx;
}

.me-role-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #4A3B38;
}

.me-role-switch {
  font-size: 26rpx;
  font-weight: 600;
  color: #FF7A9E;
}

/* 底部 */
.me-foot {
  margin-top: 20rpx;
  text-align: center;
  font-size: 23rpx;
  color: #C9B6AF;
}
