/* 订单评价页：一菜一卡，星级 + 快捷标签 + 一句话 */

.page {
  padding: 24rpx 24rpx 40rpx;
  /* 非 tab 页，只需让开底部安全区 */
  padding-bottom: 40rpx;
  padding-bottom: calc(40rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

/* ---------- 顶部概况 ---------- */

.rv-hero {
  padding: 28rpx;
  margin-bottom: 20rpx;
}

.rv-hero-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.rv-hero-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #4A3B38;
}

.rv-progress {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: 24rpx;
  line-height: 40rpx;
  font-weight: 600;
  color: #E85C8A;
  background: #FFE9EE;
  border-radius: var(--radius-pill);
  padding: 0 20rpx;
}

.rv-progress-done {
  color: #1FA65A;
  background: #E8F9EE;
}

/* 元信息小标签：负外边距做间距，不用 flex gap（安卓部分内核不支持） */
.rv-meta {
  display: flex;
  flex-wrap: wrap;
  margin: -6rpx;
}

.rv-meta-chip {
  margin: 6rpx;
  font-size: 23rpx;
  line-height: 40rpx;
  color: #8A7772;
  background: #FFF7F2;
  border: 2rpx solid #F6E3DC;
  border-radius: var(--radius-pill);
  padding: 0 18rpx;
}

.rv-avg {
  display: flex;
  align-items: baseline;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 2rpx dashed #F3E4DD;
}

.rv-avg-num {
  font-size: 34rpx;
  font-weight: 700;
  color: #E08A4B;
}

.rv-avg-sub {
  margin-left: 14rpx;
  font-size: 22rpx;
  color: #C9B6AF;
}

.rv-sub {
  margin-top: 18rpx;
  font-size: 24rpx;
  color: #B9A29B;
  line-height: 1.6;
}

.rv-remark {
  font-size: 24rpx;
  line-height: 1.6;
  color: #C97B8E;
  background: #FFF0F4;
  border-radius: 16rpx;
  padding: 18rpx 24rpx;
  margin-bottom: 20rpx;
}

/* ---------- 菜品卡 ---------- */

.rv-card {
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.rv-dish {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.rv-dish-left {
  flex: 1;
  min-width: 0;
}

.rv-dish-line {
  display: flex;
  align-items: center;
  min-width: 0;
}

.rv-dish-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #4A3B38;
}

.rv-qty {
  flex-shrink: 0;
  padding-left: 16rpx;
  font-size: 26rpx;
  color: #B9A29B;
}

.rv-note {
  margin-top: 6rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: #C08A7A;
  word-break: break-all;
}

/* 辣度标签（与订单页同配色；页面样式按页隔离，所以这里要再写一份） */
.rv-spice {
  flex-shrink: 0;
  margin-left: 12rpx;
  padding: 2rpx 12rpx;
  border-radius: var(--radius-pill);
  font-size: 22rpx;
  line-height: 32rpx;
}

/* 辣度皮肤（.spice-0 ~ .spice-3）已收进 styles/common.wxss。
   原先五个页面各写一份（待做页那份还漂移过色值），同一档辣度会显示成两种颜色。 */
/* ---------- 星级 ---------- */

.rv-stars-row {
  display: flex;
  align-items: center;
  margin-top: 22rpx;
}

.rv-stars {
  display: flex;
  align-items: center;
}

.rv-star {
  /* 星与星之间用自身 padding 撑开，避免依赖 flex gap */
  padding: 0 8rpx;
  font-size: 48rpx;
  line-height: 1.15;
  color: #F0E0DA;
  /* 点星时从灰跳到金，没有过渡会很突兀（尤其连点几颗） */
  transition: color 0.15s ease;
}

.rv-star-on {
  color: #FFB300;
}

.rv-rating-label {
  margin-left: 14rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #E08A4B;
}

/* ---------- 快捷标签 ---------- */

.rv-tags {
  display: flex;
  flex-wrap: wrap;
  margin: -7rpx;
  margin-top: 14rpx;
}

.rv-tag {
  margin: 7rpx;
  background: #FFF7F2;
  border: 2rpx dashed #F0CFC6;
  border-radius: var(--radius-pill);
  padding: 10rpx 22rpx;
  font-size: 24rpx;
  color: #B9A29B;
}

.rv-tag-on {
  background: #FFE9EE;
  border-style: solid;
  border-color: #FFB3C7;
  color: #FF5C8A;
  font-weight: 600;
}

/* ---------- 一句话 ---------- */

.rv-text-row {
  display: flex;
  align-items: center;
  margin-top: 18rpx;
  background: #FFF7F2;
  border: 2rpx solid #F6E3DC;
  border-radius: 16rpx;
  padding: 0 20rpx;
}

.rv-text {
  flex: 1;
  min-width: 0;
  height: 84rpx;
  font-size: 27rpx;
  color: #4A3B38;
}

.rv-ph {
  color: #D9C6BF;
  font-size: 25rpx;
}

.rv-text-count {
  flex-shrink: 0;
  margin-left: 12rpx;
  font-size: 22rpx;
  color: #C9B6AF;
}

/* ---------- 这一条的底部 ---------- */

.rv-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
}

.rv-state-on {
  font-size: 23rpx;
  font-weight: 600;
  color: #1FA65A;
}

.rv-state-off {
  font-size: 23rpx;
  color: #C9B6AF;
}

.rv-acts {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  justify-content: flex-end;
}

.rv-act-ghost {
  margin-left: 14rpx;
  padding: 12rpx 22rpx;
  border-radius: var(--radius-pill);
  font-size: 23rpx;
  border: 2rpx solid #EAD9D3;
  color: #8A7772;
}

.rv-save {
  margin-left: 14rpx;
  padding: 12rpx 26rpx;
  border-radius: var(--radius-pill);
  font-size: 23rpx;
  font-weight: 600;
  color: #ffffff;
  background: var(--grad-main);
}

.rv-saved-tip {
  margin-left: 14rpx;
  font-size: 22rpx;
  color: #D9C6BF;
}

/* ---------- 收尾 ---------- */

.rv-bottom {
  margin-top: 8rpx;
  text-align: center;
}

.rv-bottom-tip {
  font-size: 24rpx;
  line-height: 1.7;
  color: #1FA65A;
  margin-bottom: 24rpx;
}

.rv-bottom-off {
  color: #B9A29B;
}

.rv-back {
  display: inline-block;
  background: var(--grad-main);
  color: #ffffff;
  font-size: 27rpx;
  font-weight: 600;
  padding: 20rpx 56rpx;
  border-radius: var(--radius-pill);
  box-shadow: 0 8rpx 20rpx rgba(255, 122, 158, 0.28);
}
