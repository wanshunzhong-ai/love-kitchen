/* 菜单日志：按天分组的流水 */

.page {
  padding: 24rpx;
  /* 非 tab 页（navigateTo 进来，有原生返回栏），底部只需让开全面屏手势条 */
  padding-bottom: 60rpx;
  padding-bottom: calc(40rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

/* 说明 */
.lg-intro {
  padding: 0 8rpx;
  margin-bottom: 20rpx;
}

.lg-intro-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #B4435E;
}

.lg-intro-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #B9A29B;
}

/* 筛选：不用 flex gap（安卓低版本内核不支持），用子项 margin-right */
.lg-filters {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  padding: 0 4rpx;
}

.lg-chip {
  background: #ffffff;
  color: #B9A29B;
  font-size: 24rpx;
  font-weight: 600;
  padding: 10rpx 26rpx;
  border-radius: var(--radius-pill);
  border: 2rpx solid #FFE6EE;
  margin-right: 14rpx;
}

.lg-chip-on {
  background: var(--grad-main);
  color: #ffffff;
  border-color: transparent;
}

/* 日期分组 */
.lg-day {
  margin-bottom: 8rpx;
}

.lg-day-label {
  font-size: 24rpx;
  font-weight: 700;
  color: #B9A29B;
  padding: 16rpx 8rpx 12rpx;
}

/* 一条流水 */
.lg-row {
  display: flex;
  align-items: flex-start;
  padding: 24rpx;
  margin-bottom: 14rpx;
  /* 基础类先占住这 8rpx，高亮行只换颜色 —— 否则干饭人的行会比别人矮 8rpx，右边参差不齐 */
  border-left: 8rpx solid transparent;
}

/* 干饭人动的：左侧一道粉条 + 蜜桃色底，扫一眼就能从一堆记录里挑出来 */
.lg-row-ta {
  border-left-color: var(--brand);
  background: var(--grad-panel);
}

.lg-icon {
  width: 56rpx;
  flex-shrink: 0;
  font-size: 34rpx;
  line-height: 1.3;
}

.lg-body {
  flex: 1;
  min-width: 0;
}

.lg-line {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
}

.lg-who {
  font-size: 25rpx;
  font-weight: 700;
  color: #7A625B;
  margin-right: 12rpx;
}

.lg-who-ta {
  color: #FF5C8A;
}

.lg-title {
  font-size: 27rpx;
  color: #4A3B36;
  line-height: 1.5;
}

/* 改菜时列出的「字段 旧值 → 新值」，一行一处 */
.lg-detail {
  margin-top: 8rpx;
  font-size: 23rpx;
  line-height: 1.7;
  color: #A08E88;
}

.lg-time {
  flex-shrink: 0;
  padding-left: 16rpx;
  font-size: 22rpx;
  color: #C4B2AC;
  line-height: 1.5;
}
