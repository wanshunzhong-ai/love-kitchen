/**爱心小厨房 · 全局样式**/

/* ============================================================
   兼容性约定（改样式前先读这段）
   ------------------------------------------------------------
   1) 间距一律用 margin，**不要用 flex gap**
      部分 Android 微信内核（XWeb 低版本）不支持 flex 的 gap 属性，
      真机上会直接退化成 0 间距 —— 标签、按钮全粘成一坨。
      需要「自动换行 + 等距」时用「负外边距容器 + 子项外边距」：
        .tags   { display: flex; flex-wrap: wrap; margin: -7rpx; }
        .tags > { margin: 7rpx; }            → 实际间距 14rpx
   2) 安全区一律「常量兜底 + calc(env())」双写
      不写兜底时，一旦运行环境不认 env() 整条声明会失效（归零）。
   3) 字号下限 22rpx（≈11px），再小的字在真机上基本看不清。
   4) 自定义 tabBar 是页面级原生层，页面内元素（含 z-index）盖不住它，
      浮层要么避让它的高度，要么打开时把它藏起来。
   ============================================================ */

page {
  background: #FFF7F3;
  font-size: 28rpx;
  color: #4A3B38;
  /* 补 system-ui，安卓端走系统字体（Roboto / 思源黑体），字形更统一 */
  font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Helvetica Neue', 'PingFang SC',
    'Hiragino Sans GB', 'Microsoft YaHei', 'Source Han Sans SC', 'Noto Sans CJK SC', sans-serif;
}

/* 通用卡片 */
.card {
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 6rpx 24rpx rgba(255, 122, 158, 0.08);
}

/* 主按钮 */
.btn-main {
  background: linear-gradient(135deg, #FF7A9E, #FF9F43);
  color: #ffffff;
  border-radius: 999rpx;
  font-weight: 600;
  border: none;
}

.btn-main::after {
  border: none;
}

.btn-main[disabled] {
  opacity: 0.5;
  color: #ffffff;
}

/* 空状态 / 加载 / 错误提示 */
.state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx;
  color: #B9A29B;
}

.state-emoji {
  font-size: 88rpx;
  margin-bottom: 24rpx;
}

.state-tip {
  margin-bottom: 32rpx;
  line-height: 1.6;
  text-align: center;
}

.state-sub {
  font-size: 24rpx;
  line-height: 1.7;
  text-align: center;
  color: #CBB8B2;
  margin: -16rpx 0 32rpx;
  padding: 0 20rpx;
}

.btn-retry {
  background: linear-gradient(135deg, #FF7A9E, #FF9F43);
  color: #ffffff;
  border-radius: 999rpx;
  font-size: 26rpx;
  padding: 0 48rpx;
  line-height: 72rpx;
  border: none;
}

.btn-retry::after {
  border: none;
}

/* 用餐时间选择（结算页 / 编辑订单页共用） */
.dine-dates {
  white-space: nowrap;
  margin-bottom: 16rpx;
}

.dine-dates .dine-chip {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  min-width: 128rpx;
  margin-right: 14rpx;
  padding: 12rpx 20rpx;
  border-radius: 20rpx;
  background: #FFF3EE;
  color: #8A6F68;
  transition: all 0.15s;
}

/* 负外边距容器：等价于 gap 14rpx，但不依赖 flex gap（见文件头兼容性约定） */
.dine-slots {
  display: flex;
  flex-wrap: wrap;
  margin: -7rpx;
}

.dine-slots .dine-chip {
  margin: 7rpx;
  padding: 14rpx 30rpx;
  border-radius: 999rpx;
  background: #FFF3EE;
  color: #8A6F68;
  transition: all 0.15s;
}

.dine-chip-on {
  background: linear-gradient(135deg, #FF7A9E, #FF9F43) !important;
  color: #ffffff !important;
  font-weight: 600;
}

.dine-chip-off {
  opacity: 0.4;
}

.dc-label {
  font-size: 26rpx;
  line-height: 1.3;
}

.dc-sub {
  font-size: 22rpx;
  opacity: 0.75;
  line-height: 1.3;
}

/* ------------------------------------------------------------
   实时变化提示条（待做页 / 订单页共用，见 utils/live.js）
   ------------------------------------------------------------
   浮在内容之上、6 秒后自动消失，点一下去对应的页面。
   为什么不做成 wx.showToast：提示条要能被点击跳转，toast 不行。
   ------------------------------------------------------------ */
.notice {
  position: fixed;
  top: 20rpx;
  left: 24rpx;
  right: 24rpx;
  z-index: 60;
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border: 2rpx solid #FFD3E0;
  border-radius: 999rpx;
  padding: 16rpx 26rpx;
  box-sizing: border-box;
  box-shadow: 0 10rpx 30rpx rgba(255, 122, 158, 0.22);
  /* 浮层动画：从上方滑入，给一点「刚到的消息」的观感 */
  animation: notice-in 0.22s ease-out;
}

@keyframes notice-in {
  from {
    opacity: 0;
    transform: translateY(-24rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.notice-emoji {
  flex-shrink: 0;
  margin-right: 12rpx;
  font-size: 34rpx;
  line-height: 1.2;
}

.notice-text {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  font-weight: 600;
  color: #4A3B38;
  /* 单行省略：提示条高度必须稳定，不能被长文案撑成两行 */
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.notice-go {
  flex-shrink: 0;
  margin-left: 12rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #FF7A9E;
}
