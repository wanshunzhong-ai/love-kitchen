/**爱心小厨房 · 全局样式**/

/* 设计 token（品牌色 / 主渐变 / 圆角 / 阴影）+ 辣度皮肤 → styles/common.wxss
   空态三态视觉（.state / .state-* / .btn-retry） → styles/state.wxss
   按压反馈（.tap-hover，供 hover-class 引用） → styles/tap.wxss
   @import 由 wxss 编译期内联，等价于写在这里，页面全局可用；
   组件也 import 同一份，做到组件内自洽。
   详见这三个文件的头部注释。 */
@import "styles/common.wxss";
@import "styles/state.wxss";
@import "styles/tap.wxss";

/* ============================================================
   兼容性约定（改样式前先读这段）
   ------------------------------------------------------------
   1) 间距一律用 margin，**不要用 flex gap**
      部分 Android 微信内核（XWeb 低版本）不支持 flex 的 gap 属性，
      真机上会直接退化成 0 间距 —— 标签、按钮全粘成一坨。
      需要「自动换行 + 等距」时用「负外边距容器 + 子项外边距」：
        .tags   { display: flex; flex-wrap: wrap; margin: -7rpx; }
        .tags > { margin: 7rpx; }            → 实际间距 14rpx
   2) 安全区一律「常量兜底 + calc(env())」双写
      不写兜底时，一旦运行环境不认 env() 整条声明会失效（归零）。
   3) 字号下限 22rpx（≈11px），再小的字在真机上基本看不清。
   4) 自定义 tabBar 是页面级原生层，页面内元素（含 z-index）盖不住它，
      浮层要么避让它的高度，要么打开时把它藏起来。
   ============================================================ */

page {
  background: #FFF7F3;
  font-size: 28rpx;
  color: #4A3B38;
  /* 补 system-ui，安卓端走系统字体（Roboto / 思源黑体），字形更统一 */
  font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Helvetica Neue', 'PingFang SC',
    'Hiragino Sans GB', 'Microsoft YaHei', 'Source Han Sans SC', 'Noto Sans CJK SC', sans-serif;
}

/* 通用卡片 */
.card {
  background: #ffffff;
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-card);
}

/* 主按钮 */
.btn-main {
  background: var(--grad-main);
  color: #ffffff;
  border-radius: var(--radius-pill);
  font-weight: 600;
  border: none;
}

.btn-main::after {
  border: none;
}

.btn-main[disabled] {
  opacity: 0.5;
  color: #ffffff;
}

/* 空态 / 加载 / 错误 的视觉（.state / .state-* / .btn-retry）
   已收进 styles/common.wxss，由 components/state-block 统一渲染。
   这里不再重复定义 —— 重复定义会因页面样式表后加载而覆盖全局那套。 */

/* 用餐时间选择（结算页 / 编辑订单页共用） */
.dine-dates {
  white-space: nowrap;
  margin-bottom: 16rpx;
}

.dine-dates .dine-chip {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  min-width: 128rpx;
  margin-right: 14rpx;
  padding: 12rpx 20rpx;
  border-radius: 20rpx;
  background: #FFF3EE;
  color: #8A6F68;
  transition: all 0.15s;
}

/* 负外边距容器：等价于 gap 14rpx，但不依赖 flex gap（见文件头兼容性约定） */
.dine-slots {
  display: flex;
  flex-wrap: wrap;
  margin: -7rpx;
}

.dine-slots .dine-chip {
  margin: 7rpx;
  padding: 14rpx 30rpx;
  border-radius: var(--radius-pill);
  background: #FFF3EE;
  color: #8A6F68;
  transition: all 0.15s;
}

.dine-chip-on {
  background: var(--grad-main) !important;
  color: #ffffff !important;
  font-weight: 600;
}

.dine-chip-off {
  opacity: 0.4;
}

.dc-label {
  font-size: 26rpx;
  line-height: 1.3;
}

.dc-sub {
  font-size: 22rpx;
  opacity: 0.75;
  line-height: 1.3;
}

/* 时段 chip 上的截止时刻（如「早餐 10:00」）—— 让「几点前点单」一眼可见，
   不必点一下才知道已经不能订了。字号守住 22rpx 下限（兼容性约定第 3 条）。 */
.dc-end {
  font-size: 22rpx;
  opacity: 0.7;
  margin-left: 8rpx;
}

/* ------------------------------------------------------------
   忌口清单卡片（结算页 / 编辑订单页共用）
   ------------------------------------------------------------
   忌口是「会跟着订单送到掌勺人手上」的硬信息，所以用实心粉牌强调，
   跟「我的」页那份清单是同一套视觉语言（那边每条可点即删，这边只展示）。
   排版用负外边距容器，不用 flex gap（见文件头兼容性约定第 1 条）。
   ------------------------------------------------------------ */
.avoid-wrap {
  display: flex;
  flex-wrap: wrap;
  margin: -7rpx;
}

.avoid-chip {
  margin: 7rpx;
  background: var(--grad-pink);
  border: 2rpx solid #FFD3E0;
  border-radius: var(--radius-pill);
  padding: 10rpx 24rpx;
  font-size: 25rpx;
  font-weight: 600;
  color: #B4435E;
  max-width: 340rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.avoid-none {
  font-size: 24rpx;
  color: #C4B2AC;
  line-height: 1.6;
}

.avoid-add {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 2rpx dashed #FFE0D6;
  font-size: 25rpx;
  font-weight: 600;
  color: var(--brand);
}

.avoid-count {
  font-size: 22rpx;
  font-weight: 400;
  color: #C4B2AC;
}

/* ------------------------------------------------------------
   忌口警示条（待做页 / 订单页共用）
   ------------------------------------------------------------
   掌勺人开火前最该扫到的一行，所以用暖红底 + 左侧粗边条，
   跟卡片上其它浅灰信息（用餐时间、备注）明确区分。
   word-break 兜底：忌口是自由文本，长词不截断会撑破卡片。
   ------------------------------------------------------------ */
.order-avoids {
  margin-top: 14rpx;
  padding: 14rpx 20rpx;
  background: var(--grad-warn);
  border-left: 6rpx solid #FF6B6B;
  border-radius: 12rpx;
  font-size: 25rpx;
  font-weight: 600;
  color: #C0392B;
  line-height: 1.5;
  word-break: break-all;
}

/* ------------------------------------------------------------
   实时变化提示条（待做页 / 订单页共用，见 utils/live.js）
   ------------------------------------------------------------
   浮在内容之上、6 秒后自动消失，点一下去对应的页面。
   为什么不做成 wx.showToast：提示条要能被点击跳转，toast 不行。
   ------------------------------------------------------------ */
.notice {
  position: fixed;
  top: 20rpx;
  left: 24rpx;
  right: 24rpx;
  z-index: 60;
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border: 2rpx solid #FFD3E0;
  border-radius: var(--radius-pill);
  padding: 16rpx 26rpx;
  box-sizing: border-box;
  box-shadow: var(--shadow-float);
  /* 浮层动画：从上方滑入，给一点「刚到的消息」的观感 */
  animation: notice-in 0.22s ease-out;
}

@keyframes notice-in {
  from {
    opacity: 0;
    transform: translateY(-24rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.notice-emoji {
  flex-shrink: 0;
  margin-right: 12rpx;
  font-size: 34rpx;
  line-height: 1.2;
}

.notice-text {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  font-weight: 600;
  color: #4A3B38;
  /* 单行省略：提示条高度必须稳定，不能被长文案撑成两行 */
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.notice-go {
  flex-shrink: 0;
  margin-left: 12rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--brand);
}
