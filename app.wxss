/**爱心小厨房 · 全局样式**/
page {
  background: #FFF7F3;
  font-size: 28rpx;
  color: #4A3B38;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
}

/* 通用卡片 */
.card {
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 6rpx 24rpx rgba(255, 122, 158, 0.08);
}

/* 主按钮 */
.btn-main {
  background: linear-gradient(135deg, #FF7A9E, #FF9F43);
  color: #ffffff;
  border-radius: 999rpx;
  font-weight: 600;
  border: none;
}

.btn-main::after {
  border: none;
}

.btn-main[disabled] {
  opacity: 0.5;
  color: #ffffff;
}

/* 空状态 / 加载 / 错误提示 */
.state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx;
  color: #B9A29B;
}

.state-emoji {
  font-size: 88rpx;
  margin-bottom: 24rpx;
}

.state-tip {
  margin-bottom: 32rpx;
  line-height: 1.6;
  text-align: center;
}

.btn-retry {
  background: linear-gradient(135deg, #FF7A9E, #FF9F43);
  color: #ffffff;
  border-radius: 999rpx;
  font-size: 26rpx;
  padding: 0 48rpx;
  line-height: 72rpx;
  border: none;
}

.btn-retry::after {
  border: none;
}
